<?xml version="1.0" encoding="utf-8" ?>
<!--
    Windows' own controls in Neap's colours: the page frame, settings rows,
    buttons, lists, text fields and sliders.
    
    These sit on the navigation view rather than in the app's resources. A
    control's template looks for its colours in its own dictionary before the
    app's, so an app-level override never reaches it; resources on an
    ancestor are looked in first.
    
    Only the dark and light themes are named. High contrast keeps Windows'
    own colours throughout.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">22</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">11</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#110E19" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#171322" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#282238" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#269D8CFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#339D8CFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1F9D8CFF" />

            <SolidColorBrush x:Key="SettingsCardBackground" Color="#221C31" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#29223A" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#1E192C" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#342B49" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="#3F3556" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPressed" Color="#342B49" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#221C31" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#342B49" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#3F3556" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#342B49" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1D182B" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#342B49" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#2A2340" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#332A4C" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#241E36" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B3351" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4A4063" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3B3351" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#2A2340" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#332A4C" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#241E36" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3B3351" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4A4063" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3B3351" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#1E1929" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#251F33" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3B3351" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4063" />

            <SolidColorBrush x:Key="SliderTrackFill" Color="#332B47" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3B3351" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#332B47" />
            <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#7C6AE8" />
                <GradientStop Offset="1" Color="#B2A5FF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#8B7AF0" />
                <GradientStop Offset="1" Color="#C8BEFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#7C6AE8" />
                <GradientStop Offset="1" Color="#B2A5FF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#F2EEFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#9D8CFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#B2A5FF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#8B7AF0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EFECF6" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F7F5FB" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E2DEEC" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#266D5AD9" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#336D5AD9" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1F6D5AD9" />

            <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#FAF9FD" />
            <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#F4F2F9" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#E2DEEC" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="#D6D1E3" />
            <SolidColorBrush x:Key="SettingsCardBorderBrushPressed" Color="#E2DEEC" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#E2DEEC" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#D6D1E3" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="#E2DEEC" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FAF8FD" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#E2DEEC" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F6F4FB" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EFECF6" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#DDD8E8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CFC8DE" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#DDD8E8" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F6F4FB" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#EFECF6" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#DDD8E8" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#CFC8DE" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#DDD8E8" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FAF9FD" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#DDD8E8" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CFC8DE" />

            <SolidColorBrush x:Key="SliderTrackFill" Color="#DCD6EA" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#D0C9E1" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#DCD6EA" />
            <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#5845BD" />
                <GradientStop Offset="1" Color="#8B7AF0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#6D5AD9" />
                <GradientStop Offset="1" Color="#9D8CFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#5845BD" />
                <GradientStop Offset="1" Color="#8B7AF0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#6D5AD9" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#5845BD" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#40309A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel MaxWidth="1040" Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Audio_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--
                    With the headset off, the whole page is one card: Windows'
                    volume goes on working without it, but on nothing the person
                    can hear. See HeadsetSection.WhenOff. Wider than other pages,
                    for the equaliser's list beside its curve.
                -->
                <c:HeadsetSection x:Uid="Audio_Section" WhenOff="True">
                    <!--
                        The equaliser first, since it is what this page is opened for:
                        the presets down the left and the curve beside them.
                    -->
                    <c:HeadsetSection x:Uid="Audio_HeadsetSection">
                        <TextBlock x:Uid="Audio_EqualiserHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <c:EqualiserPanel Bank="Game" />

                        <!--
                            Noise cancellation and Superhuman Hearing as Home's tiles,
                            side by side, with how strong each is under it while it is on.
                        -->
                        <TextBlock x:Uid="Audio_AroundYouHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:SettingTile
                                x:Uid="Audio_AncTile"
                                Glyph="&#xE7F6;"
                                Setting="anc">
                                <StackPanel Spacing="4">
                                    <c:SettingRow x:Uid="Audio_AncIntensity" Setting="anc_level" />
                                </StackPanel>
                            </c:SettingTile>
                            <c:SettingTile
                                x:Uid="Audio_ShhTile"
                                Grid.Column="1"
                                Glyph="&#xF270;"
                                Setting="superhuman_hearing">
                                <StackPanel Spacing="4">
                                    <c:SettingRow x:Uid="Audio_Type" Setting="shh_preset" />
                                    <c:SettingRow x:Uid="Audio_Intensity" Setting="shh_level" />
                                </StackPanel>
                            </c:SettingTile>
                        </Grid>
                    </c:HeadsetSection>

                    <!--
                        Windows' own volume, with its mute beside it on one line, last:
                        the headset's wheel is the everyday way to change it.
                    -->
                    <TextBlock x:Uid="Audio_VolumeHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <c:RoutingNotice Margin="0,0,0,8" Microphone="False" />
                    <c:WindowsVolumeRow
                        x:Uid="Audio_MasterVolume"
                        Kind="Volume"
                        WithMute="True" />
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


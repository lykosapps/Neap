<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Audio_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--
                    With the headset off, the whole page is one card: Windows'
                    volume goes on working without it, but on nothing the person
                    can hear. See HeadsetSection.WhenOff.
                -->
                <c:HeadsetSection x:Uid="Audio_Section" WhenOff="True">
                    <!--
                        The equaliser first, since it is what this page is
                        opened for. Noise cancellation and Superhuman Hearing
                        each take one line with their switch; what matters
                        only once one is on sits inside it.
                    -->
                    <c:HeadsetSection x:Uid="Audio_HeadsetSection">
                        <TextBlock x:Uid="Audio_EqualiserHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <c:EqualiserPanel Bank="Game" />

                        <TextBlock x:Uid="Audio_NoiseCancellationHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <tk:SettingsExpander x:Uid="Audio_ActiveNoiseCancellation">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE7F6;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <c:SettingToggle x:Uid="Audio_AncSwitch" Setting="anc" />
                            <tk:SettingsExpander.Items>
                                <c:SettingRow x:Uid="Audio_AncIntensity" Setting="anc_level" />
                            </tk:SettingsExpander.Items>
                        </tk:SettingsExpander>

                        <TextBlock x:Uid="Audio_SuperhumanHearingHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <tk:SettingsExpander x:Uid="Audio_SuperhumanHearing">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xF270;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <c:SettingToggle x:Uid="Audio_ShhSwitch" Setting="superhuman_hearing" />
                            <tk:SettingsExpander.Items>
                                <c:SettingRow x:Uid="Audio_Type" Setting="shh_preset" />
                                <c:SettingRow x:Uid="Audio_Intensity" Setting="shh_level" />
                            </tk:SettingsExpander.Items>
                        </tk:SettingsExpander>
                    </c:HeadsetSection>

                    <!--
                        Windows' own volume and mute, last: the headset's wheel
                        is the everyday way to change them.
                    -->
                    <TextBlock x:Uid="Audio_VolumeHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Uid="Audio_VolumeNote" Style="{StaticResource SectionNoteStyle}" />
                    <StackPanel>
                        <c:RoutingNotice Margin="0,0,0,8" Microphone="False" />
                        <StackPanel Spacing="4">
                            <c:WindowsVolumeRow
                                x:Uid="Audio_Mute"
                                Glyph="&#xE74F;"
                                Kind="Mute" />
                            <c:WindowsVolumeRow
                                x:Uid="Audio_MasterVolume"
                                Glyph="&#xE994;"
                                Kind="Volume" />
                        </StackPanel>
                    </StackPanel>
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


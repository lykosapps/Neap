<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel
                Padding="0,24,0,0"
                Spacing="16"
                Style="{StaticResource PageColumnStyle}">

                <!--  Nothing plugged in is said first, in words.  -->
                <c:HeadsetNotice />

                <c:QuickControls />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StealthPro.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <StackPanel>

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Running" />
            <TextBlock Style="{StaticResource SectionNoteStyle}" Text="Closing the window leaves the app running in the notification area, so the chat wheel and the mix keep working. Quit from its menu there to stop it altogether." />
            <StackPanel Spacing="4">
                <tk:SettingsCard
                    Description="Starts quietly in the notification area, so the chat wheel and the mix work from the moment you log in."
                    Header="Start with Windows">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartWithWindows" />
                </tk:SettingsCard>

            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="About" />
            <StackPanel Spacing="4">
                <tk:SettingsCard x:Name="AboutCard" Header="Stealth Pro II Control">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F6;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

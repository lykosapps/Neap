<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Device_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--  Listed whenever anything answers, the headset on or off.  -->
                <c:TransmittersPanel />

                <c:HeadsetSection Explain="False">
                    <!--
                        The lights of the transmitter carrying the headset,
                        beside the list of transmitters and named for the
                        one in use.
                    -->
                    <StackPanel>
                        <TextBlock
                            x:Name="LightsHeader"
                            x:Uid="Device_LightsHeader"
                            Style="{StaticResource SectionHeaderStyle}"
                            Visibility="Collapsed" />
                        <StackPanel Spacing="4">
                            <c:SettingRow
                                x:Name="DockRing"
                                x:Uid="Device_DockRing"
                                Glyph="&#xE706;"
                                Setting="led_brightness_1"
                                Unit="%"
                                Visibility="Collapsed" />
                            <c:SettingRow
                                x:Name="DockStatus"
                                x:Uid="Device_DockStatus"
                                Glyph="&#xE706;"
                                Setting="led_brightness_2"
                                Unit="%"
                                Visibility="Collapsed" />
                            <c:SettingRow
                                x:Name="TransmitterLight"
                                x:Uid="Device_TransmitterLight"
                                Glyph="&#xE706;"
                                Setting="led_brightness_1"
                                Unit="%"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </c:HeadsetSection>

                <!--
                    With the headset off, the whole page is one card, the audio
                    format included: see HeadsetSection.WhenOff.
                -->
                <c:HeadsetSection x:Uid="Device_Section" WhenOff="True">
                    <TextBlock x:Uid="Device_AudioFormatHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Uid="Device_FormatNote" Style="{StaticResource SectionNoteStyle}" />
                    <StackPanel Spacing="4">
                        <c:FormatRow
                            x:Uid="Device_HeadsetOutput"
                            Capture="False"
                            Glyph="&#xE7F5;" />
                        <c:FormatRow
                            x:Uid="Device_Microphone"
                            Capture="True"
                            Glyph="&#xE720;" />
                    </StackPanel>

                    <c:HeadsetSection x:Uid="Device_DetailsSection">
                        <TextBlock x:Uid="Device_AboutHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Spacing="4">
                            <c:SettingRow
                                x:Uid="Device_Firmware"
                                Glyph="&#xE950;"
                                Setting="firmware_version" />
                            <c:SettingRow
                                x:Uid="Device_SerialNumber"
                                Glyph="&#xE8EC;"
                                Setting="serial_number" />
                        </StackPanel>

                        <TextBlock x:Uid="Device_ReportedHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <tk:SettingsExpander x:Uid="Device_RawValues">
                            <tk:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE8A1;" />
                            </tk:SettingsExpander.HeaderIcon>
                            <tk:SettingsExpander.ItemsHeader>
                                <StackPanel
                                    x:Name="RawRows"
                                    Padding="16,8"
                                    Spacing="2" />
                            </tk:SettingsExpander.ItemsHeader>
                        </tk:SettingsExpander>
                    </c:HeadsetSection>
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>



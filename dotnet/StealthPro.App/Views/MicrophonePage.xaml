<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.MicrophonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel MaxWidth="1040" Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Microphone_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--
                    With the headset off, the whole page is one card, the level
                    included: see HeadsetSection.WhenOff.
                -->
                <c:HeadsetSection x:Uid="Microphone_Section" WhenOff="True">
                    <TextBlock x:Uid="Microphone_MicrophoneHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel>
                        <c:RoutingNotice Margin="0,0,0,8" Sound="False" />
                        <StackPanel Spacing="4">
                            <c:HeadsetSection Explain="False">
                                <tk:SettingsCard x:Uid="Microphone_Mic">
                                    <tk:SettingsCard.HeaderIcon>
                                        <FontIcon x:Name="MicIcon" Glyph="&#xE720;" />
                                    </tk:SettingsCard.HeaderIcon>
                                    <c:MicSwitch x:Name="Mic" />
                                </tk:SettingsCard>
                            </c:HeadsetSection>
                            <!--
                                What the microphone hears, while this page is open: Windows shows
                                its microphone in use light for as long as the meter listens.
                            -->
                            <tk:SettingsCard x:Uid="Microphone_Level">
                                <tk:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE9D9;" />
                                </tk:SettingsCard.HeaderIcon>
                                <c:MicMeter x:Uid="Microphone_Meter" />
                            </tk:SettingsCard>
                            <c:WindowsVolumeRow
                                x:Uid="Microphone_Sensitivity"
                                Capture="True"
                                Glyph="&#xE9E9;"
                                Kind="Volume" />
                            <c:HeadsetSection Explain="False">
                                <c:SettingRow
                                    x:Uid="Microphone_MicMonitoring"
                                    Glyph="&#xE95B;"
                                    Setting="mic_monitoring" />
                            </c:HeadsetSection>
                        </StackPanel>
                    </StackPanel>

                    <c:HeadsetSection x:Uid="Microphone_HeadsetSection">
                        <TextBlock x:Uid="Microphone_NoiseHandlingHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Spacing="4">
                            <c:SettingRow
                                x:Uid="Microphone_AINoiseReduction"
                                Glyph="&#xF4A5;"
                                Setting="ai_noise_reduction" />
                            <c:SettingRow
                                x:Uid="Microphone_NoiseGate"
                                Glyph="&#xE71C;"
                                Setting="noise_gate" />
                            <c:SettingRow
                                x:Uid="Microphone_Threshold"
                                Glyph="&#xED5E;"
                                Setting="noise_gate_threshold" />
                        </StackPanel>

                        <TextBlock x:Uid="Microphone_EqualiserHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <c:EqualiserPanel Bank="Mic" />
                    </c:HeadsetSection>
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

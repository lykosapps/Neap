<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthPro.App.Views.MicrophonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Microphone_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--
                    With the headset off, the whole page is one card, the level
                    included: see HeadsetSection.WhenOff.
                -->
                <c:HeadsetSection x:Uid="Microphone_Section" WhenOff="True">
                    <c:RoutingNotice Margin="0,0,0,12" Sound="False" />

                    <!--
                        What they hear, first: the microphone's tile, as on Home, beside a
                        wide live meter of what it picks up. The meter listens only while
                        this page is open, since Windows shows its microphone in use light
                        for as long as it does.
                    -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:HeadsetSection Explain="False">
                            <c:MicTile />
                        </c:HeadsetSection>
                        <Border
                            Grid.Column="1"
                            Padding="20,14,20,16"
                            Style="{StaticResource QuickCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="Microphone_LevelLabel" Style="{StaticResource NeapLabelStyle}" />
                                <c:MicMeter x:Uid="Microphone_Meter" Large="True" />
                                <TextBlock x:Uid="Microphone_LevelNote" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Uid="Microphone_VoiceHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Spacing="4">
                        <c:WindowsVolumeRow
                            x:Uid="Microphone_Sensitivity"
                            Capture="True"
                            Glyph="&#xE9E9;"
                            Kind="Volume" />
                        <c:HeadsetSection Explain="False">
                            <c:SettingRow
                                x:Uid="Microphone_MicMonitoring"
                                Glyph="&#xE95B;"
                                Setting="mic_monitoring" />
                        </c:HeadsetSection>
                    </StackPanel>

                    <c:HeadsetSection x:Uid="Microphone_HeadsetSection">
                        <!--
                            Noise reduction and the gate as tiles, like Audio's, with the
                            gate's threshold under it while the gate is on: it means nothing
                            while the gate is off.
                        -->
                        <TextBlock x:Uid="Microphone_NoiseHandlingHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:SettingTile
                                x:Uid="Microphone_AiTile"
                                Glyph="&#xF4A5;"
                                Setting="ai_noise_reduction" />
                            <c:SettingTile
                                x:Uid="Microphone_GateTile"
                                Grid.Column="1"
                                Glyph="&#xE71C;"
                                Setting="noise_gate">
                                <c:SettingRow x:Uid="Microphone_Threshold" Setting="noise_gate_threshold" />
                            </c:SettingTile>
                        </Grid>

                        <TextBlock x:Uid="Microphone_EqualiserHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <c:EqualiserPanel Bank="Mic" />
                    </c:HeadsetSection>
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

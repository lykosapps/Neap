<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="StealthPro.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/Themes/Generic.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/GameChatDial.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/Tiles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Game and chat, from the half moon in the mark: game is the
                twilight wave, chat is the moon, silver on dark and ink on
                light, so the two sides differ in lightness as well as in hue
                and neither reads as a status colour. Fills are at least 3:1
                against the window and text at least 4.5:1. High contrast
                uses the system's highlight and text colours instead.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <RadialGradientBrush x:Key="NeapPanelBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.2" RadiusY="0.9">
                        <GradientStop Offset="0" Color="#2A2733" />
                        <GradientStop Offset="1" Color="#1D1C22" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NeapPanelStrokeBrush" Color="#36333F" />
                    <SolidColorBrush x:Key="NeapRuleBrush" Color="#2C2A33" />
                    <SolidColorBrush x:Key="NeapGameBrush" Color="#9D8CFF" />
                    <SolidColorBrush x:Key="NeapGameTextBrush" Color="#B2A5FF" />
                    <SolidColorBrush x:Key="NeapChatBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="NeapChatTextBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="NeapDialTrackBrush" Color="#1FFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <RadialGradientBrush x:Key="NeapPanelBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.2" RadiusY="0.9">
                        <GradientStop Offset="0" Color="#FFFFFF" />
                        <GradientStop Offset="1" Color="#F0EFF5" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NeapPanelStrokeBrush" Color="#DCDBE3" />
                    <SolidColorBrush x:Key="NeapRuleBrush" Color="#DCDBE3" />
                    <SolidColorBrush x:Key="NeapGameBrush" Color="#6D5AD9" />
                    <SolidColorBrush x:Key="NeapGameTextBrush" Color="#5845BD" />
                    <SolidColorBrush x:Key="NeapChatBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="NeapChatTextBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="NeapDialTrackBrush" Color="#17000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NeapPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NeapPanelStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeapRuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeapGameBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NeapGameTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeapChatBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeapChatTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NeapDialTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Neap's twilight accent, in place of the Windows accent colour.
                Light theme fills with Dark1 and writes with Dark2, dark theme
                fills with Light2 and writes with Light3; each pairing is at
                least 4.5:1 against what sits on or behind it. High contrast
                themes use the system's own colours instead.
            -->
            <Color x:Key="SystemAccentColor">#9D8CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#B2A5FF</Color>
            <Color x:Key="SystemAccentColorLight2">#C8BEFF</Color>
            <Color x:Key="SystemAccentColorLight3">#E1DBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#6D5AD9</Color>
            <Color x:Key="SystemAccentColorDark2">#5845BD</Color>
            <Color x:Key="SystemAccentColorDark3">#40309A</Color>

            <!--
                Every page's column, held to a width that reads on a wide
                screen. It sits in a grid inside the page's scroller: placed
                straight in the scroller, a column narrower than the window
                sits off to one side.
            -->
            <Style x:Key="PageColumnStyle" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="800" />
            </Style>

            <!--
                A panel on Home, lit from the top edge like a piece of gear
                on a desk: the mix, and the note that stands in for the
                controls.
            -->
            <Style x:Key="QuickCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NeapPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NeapPanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20,16" />
            </Style>

            <!--  A small label over what it names: a panel's title, a reading's name.  -->
            <Style
                x:Key="NeapLabelStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--  A reading worth a glance, such as the battery: a big number.  -->
            <Style
                x:Key="NeapReadingStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!--
                Numbers that change while you watch, such as the mix levels.
                Figures of one width, so a level going from 99 to 100 does
                not shift everything beside it.
            -->
            <Style x:Key="NumeralTextStyle" TargetType="TextBlock">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!--  The microphone meter's bars, lit in the chat side's colour: it is your voice.  -->
            <Style x:Key="MeterLitStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource NeapChatBrush}" />
            </Style>
            <Style x:Key="MeterUnlitStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Style>

            <!--
                The dot beside the headset's state, one colour per tone.
                Styles rather than brushes set in code, so the colour
                follows a change of theme or contrast while a page is open.
            -->
            <Style x:Key="ToneGoodStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="ToneCautionStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="ToneNeutralStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
            </Style>
            <Style x:Key="ToneCriticalStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!--  The page's own name, at the top of every page.  -->
            <Style
                x:Key="PageTitleStyle"
                BasedOn="{StaticResource TitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="Margin" Value="0,8,0,16" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
            </Style>

            <!--  Groups the cards below it. Quiet: the cards are the content.  -->
            <Style
                x:Key="SectionHeaderStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,16,0,4" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <!--
                A note under a section header, for the handful of places
                where what a control does is genuinely not obvious from
                its label: the settings that belong to Windows rather than
                to the headset.
            -->
            <Style
                x:Key="SectionNoteStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="620" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!--
                Quieter text for what is built in code. Styles rather than
                brushes, so the colour follows a change of theme or contrast
                while the page is open.
            -->
            <Style
                x:Key="SecondaryBodyTextStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style
                x:Key="TertiaryBodyTextStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style
                x:Key="SecondaryCaptionTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style
                x:Key="DisabledCaptionTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="EmptySlotStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,8,14,8" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

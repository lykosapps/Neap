<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthPro.App.Controls.EqualiserPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Border
        Padding="20,16,20,20"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <StackPanel Spacing="16">

            <!--  Which preset, and whether it has been changed since.  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="PresetName"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        x:Name="EditedPill"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Uid="Equaliser_Edited"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>

                <!--
                    Always there, and disabled when they cannot be used, so
                    none moves under the pointer when a band is first
                    dragged. Overwrite goes first because its label names
                    the preset and changes width; the two after it stay put.
                    Only saving a new preset is the accent: it keeps
                    everything, where overwriting loses the old curve.
                -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="OverwriteButton" IsEnabled="False">
                        <Button.Flyout>
                            <Flyout x:Name="OverwriteConfirm">
                                <StackPanel MaxWidth="280" Spacing="12">
                                    <TextBlock
                                        x:Name="OverwriteQuestion"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button x:Name="OverwriteYes" x:Uid="Equaliser_OverwriteYes" />
                                        <Button x:Name="OverwriteNo" x:Uid="Equaliser_OverwriteNo" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="DiscardButton"
                        x:Uid="Equaliser_DiscardButton"
                        IsEnabled="False" />
                    <Button
                        x:Name="SaveButton"
                        x:Uid="Equaliser_SaveButton"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--
                The slots, factory and custom, including the empty ones:
                how many you have left is part of the decision to save.
            -->
            <ItemsControl x:Name="Slots">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <tk:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!--
                The curve and the readouts share one width and one set of
                columns, so every point sits over its own number.
            -->
            <StackPanel
                x:Name="Curve"
                MaxWidth="900"
                HorizontalAlignment="Stretch">
                <c:EqualiserCurve x:Name="Response" Height="168" />
                <Grid x:Name="Bands" Margin="0,6,0,0" />
            </StackPanel>

            <!--
                Shown until the headset reports its bands. A flat line would
                read as an equaliser set flat. The same dash the settings
                rows use: the page's notice or the folded section's card
                says why, so this only has to say there is no reading.
            -->
            <TextBlock
                x:Name="Waiting"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="—" />

        </StackPanel>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthPro.App.Controls.MicTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ToggleButton
        x:Name="Face"
        IsEnabled="False"
        Style="{StaticResource NeapToggleTileStyle}">
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon
                x:Name="Icon"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="22"
                Glyph="&#xE720;" />
            <TextBlock
                x:Uid="Quick_Microphone"
                Grid.Row="1"
                Style="{StaticResource NeapTileTitleStyle}" />
            <TextBlock
                x:Name="Word"
                Grid.Row="2"
                Style="{StaticResource NeapTileStateStyle}" />
        </Grid>
    </ToggleButton>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StealthPro.App.Controls.HeadsetStatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  A dot and a word, and nothing else.
          It grew to carry five readings — link, route, Bluetooth, signal and
          battery — in a strip sized for one, and every fact added made the
          others harder to read. They live on Home now. What belongs in a
          title bar is whether to go and look.  -->
    <StackPanel
        x:Name="ConnectionGroup"
        Orientation="Horizontal"
        Spacing="8">
        <Ellipse
            x:Name="ConnectionDot"
            Width="8"
            Height="8"
            VerticalAlignment="Center"
            Fill="{ThemeResource SystemFillColorCautionBrush}" />
        <TextBlock
            x:Name="ConnectionText"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Connecting" />
    </StackPanel>
</UserControl>

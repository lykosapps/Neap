<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <!--
        The dial's look: a raised knob with a ridged rim, inside a ring of
        segments that light in each side's colour. Every colour is a theme
        resource or a style, so a change of theme or contrast while the page
        is open repaints it without code; the code only places the shapes.
        The knob is an object on the desk, so it stays dark metal in the
        dark theme and turns brushed silver in the light one. High contrast
        drops the metal for the system's own colours.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NeapKnobWellBrush" Color="#0E0E11" />
            <LinearGradientBrush x:Key="NeapKnobBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#4A4854" />
                <GradientStop Offset="0.5" Color="#2C2B33" />
                <GradientStop Offset="1" Color="#1E1D23" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NeapKnobRimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#55FFFFFF" />
                <GradientStop Offset="1" Color="#08FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapKnobRidgeBrush" Color="#70000000" />
            <SolidColorBrush x:Key="NeapKnobCapStrokeBrush" Color="#1CFFFFFF" />
            <RadialGradientBrush x:Key="NeapKnobShadowBrush">
                <GradientStop Offset="0.7" Color="#99000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NeapKnobWellBrush" Color="#C9C9D0" />
            <LinearGradientBrush x:Key="NeapKnobBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#FBFBFD" />
                <GradientStop Offset="0.5" Color="#E6E6EB" />
                <GradientStop Offset="1" Color="#D2D2D9" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NeapKnobRimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="1" Color="#40FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapKnobRidgeBrush" Color="#33000000" />
            <SolidColorBrush x:Key="NeapKnobCapStrokeBrush" Color="#26000000" />
            <RadialGradientBrush x:Key="NeapKnobShadowBrush">
                <GradientStop Offset="0.7" Color="#44000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NeapKnobWellBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NeapKnobBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NeapKnobRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NeapKnobRidgeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapKnobCapStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NeapKnobShadowBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  One segment of the ring, unlit and lit.  -->
    <Style x:Key="NeapSegmentOffStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapDialTrackBrush}" />
        <Setter Property="StrokeThickness" Value="9" />
    </Style>
    <Style x:Key="NeapSegmentGameStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapGameBrush}" />
        <Setter Property="StrokeThickness" Value="9" />
    </Style>
    <Style x:Key="NeapSegmentChatStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapChatBrush}" />
        <Setter Property="StrokeThickness" Value="9" />
    </Style>
    <!--  The knob's pointer, in the colour of the side the mix leans to.  -->
    <Style x:Key="NeapPointerGameStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapGameTextBrush}" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>
    <Style x:Key="NeapPointerChatStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapChatTextBrush}" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style TargetType="c:GameChatDial">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="240" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="CornerRadius" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GameChatDial">
                    <Grid Background="Transparent">
                        <!--  The segments, placed by the code.  -->
                        <Canvas x:Name="Ring" />
                        <Ellipse
                            Width="194"
                            Height="194"
                            Fill="{ThemeResource NeapKnobWellBrush}" />
                        <Ellipse
                            Width="200"
                            Height="200"
                            Margin="0,12,0,0"
                            Fill="{ThemeResource NeapKnobShadowBrush}" />
                        <Ellipse
                            Width="188"
                            Height="188"
                            Fill="{ThemeResource NeapKnobBrush}" />
                        <Path
                            x:Name="Ridges"
                            Stroke="{ThemeResource NeapKnobRidgeBrush}"
                            StrokeThickness="1.6" />
                        <Ellipse
                            Width="188"
                            Height="188"
                            Stroke="{ThemeResource NeapKnobRimBrush}"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="156"
                            Height="156"
                            Fill="{ThemeResource NeapKnobBrush}"
                            Stroke="{ThemeResource NeapKnobCapStrokeBrush}"
                            StrokeThickness="1" />
                        <Path x:Name="Pointer" Style="{StaticResource NeapPointerGameStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

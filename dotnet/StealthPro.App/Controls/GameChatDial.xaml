<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <!--
        The dial's look. Every colour is a theme resource, so a change of
        theme or contrast while the page is open repaints it without code;
        the code only places the shapes. Its size is the one GameChatDial
        draws for.
    -->
    <Style TargetType="c:GameChatDial">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="240" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="CornerRadius" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GameChatDial">
                    <Grid Background="Transparent">
                        <Path
                            x:Name="Track"
                            Stroke="{ThemeResource NeapDialTrackBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="12" />
                        <Path
                            x:Name="GameArc"
                            Stroke="{ThemeResource NeapGameBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="12" />
                        <Path
                            x:Name="ChatArc"
                            Stroke="{ThemeResource NeapChatBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="12" />
                        <Ellipse
                            x:Name="Thumb"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

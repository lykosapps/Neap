<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthPro.App.Controls.QuickSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <!--
        The headset's settings reached for mid-game or mid-call, as tiles:
        the microphone and noise control side by side, and the
        equaliser across the width under them, with its curve.
    -->
    <Grid ColumnSpacing="10" RowSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:MicTile />

        <!--
            Noise control steps through its three modes in the order the Mode
            button does, and is lit for either mode that is not off.
        -->
        <ToggleButton
            x:Name="NoiseTile"
            x:Uid="Quick_NoiseTile"
            Grid.Column="1"
            IsEnabled="False"
            Style="{StaticResource NeapToggleTileStyle}">
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="22"
                    Glyph="&#xE7F6;" />
                <TextBlock
                    x:Uid="Quick_NoiseControl"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <TextBlock
                    x:Name="NoiseWord"
                    Grid.Row="2"
                    Style="{StaticResource NeapTileStateStyle}" />
            </Grid>
        </ToggleButton>

        <!--
            The equaliser is not on or off, so its tile never fills. It shows
            the curve it is on and opens the presets, each with its own
            curve, to pick one directly.
        -->
        <Button
            x:Name="PresetPicker"
            x:Uid="Quick_PresetPicker"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsEnabled="False"
            Style="{StaticResource NeapButtonTileStyle}">
            <Button.Flyout>
                <Flyout x:Name="PresetFlyout" Placement="BottomEdgeAlignedRight">
                    <ListView
                        x:Name="PresetList"
                        x:Uid="Quick_PresetList"
                        MinWidth="260"
                        SelectionMode="Single" />
                </Flyout>
            </Button.Flyout>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="22"
                    Glyph="&#xE9E9;" />
                <FontIcon
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Glyph="&#xE70D;" />
                <TextBlock
                    x:Uid="Quick_Preset"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <TextBlock
                    x:Name="PresetName"
                    Grid.Row="2"
                    Style="{StaticResource NeapTileStateStyle}" />
                <Path
                    x:Name="PresetCurve"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource NeapMiniCurveStyle}" />
            </Grid>
        </Button>
    </Grid>
</UserControl>

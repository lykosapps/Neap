<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthPro.App.Controls.MixPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StealthPro.App.Controls">

    <StackPanel Spacing="12">

        <TextBlock
            x:Uid="Mix_Title"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!--
            The chat wheel cannot reach the app, with what still moves the
            mix. Inside the mix, not in a note elsewhere, so wherever the mix
            is shown the reason comes with it.
        -->
        <InfoBar
            x:Name="WheelBar"
            x:Uid="Mix_WheelBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <!--
            The chat application is playing somewhere the mix cannot reach.
            Without this the wheel stops affecting chat and nothing says
            why.
        -->
        <InfoBar
            x:Name="ElsewhereBar"
            x:Uid="Mix_ElsewhereBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--
            Nothing chosen yet: only the question. The dial means nothing
            until it is answered, so it is absent rather than disabled.
        -->
        <TextBlock
            x:Name="SetupLine"
            x:Uid="Mix_Setup"
            Style="{StaticResource SecondaryBodyTextStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Chosen: the dial, with how loud each side plays in its middle.  -->
        <Grid
            x:Name="DialArea"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <c:GameChatDial x:Name="Dial" x:Uid="Mix_Dial" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="2">
                <TextBlock
                    x:Name="LeanText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock
                        x:Name="GameLevel"
                        FontSize="32"
                        FontWeight="SemiLight"
                        Foreground="{ThemeResource NeapGameTextBrush}"
                        Style="{StaticResource NumeralTextStyle}" />
                    <TextBlock
                        x:Name="ChatLevel"
                        FontSize="32"
                        FontWeight="SemiLight"
                        Foreground="{ThemeResource NeapChatTextBrush}"
                        Style="{StaticResource NumeralTextStyle}" />
                </StackPanel>
            </StackPanel>

            <!--  Under each end of the arc: which side is which.  -->
            <TextBlock
                x:Uid="Mix_Game"
                Margin="36,0,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource NeapGameTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Uid="Mix_Chat"
                Margin="0,0,36,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource NeapChatTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!--
            Which application carries chat: the only thing the mix needs to
            know. One picker, before and after the choice.
        -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="Mix_ChatFrom"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}" />
            <ComboBox
                x:Name="ChatPicker"
                x:Uid="Mix_ChatPicker"
                Grid.Column="1"
                HorizontalAlignment="Stretch" />
            <Button
                x:Name="Refresh"
                x:Uid="Mix_Refresh"
                Grid.Column="2">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="Notice"
            x:Uid="Mix_NothingPlaying"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

    </StackPanel>
</UserControl>

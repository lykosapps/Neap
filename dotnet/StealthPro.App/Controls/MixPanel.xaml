<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StealthPro.App.Controls.MixPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">

        <!--  Nothing chosen yet: one card asking which application carries
              chat. The rest of the mix means nothing until that is answered,
              so none of it is shown.  -->
        <tk:SettingsCard
            x:Name="SetupCard"
            x:Uid="Mix_SetupCard"
            Visibility="Collapsed">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8BD;" />
            </tk:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="SetupPicker"
                    x:Uid="Mix_SetupPicker"
                    MinWidth="200" />
                <Button x:Name="SetupRefresh" x:Uid="Mix_Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </tk:SettingsCard>

        <!--  Shown whenever the chat wheel cannot reach the app, with what
              brings it back. Directly above the slider, where somebody who has
              turned the wheel and seen nothing move is looking. The app cannot
              fix this itself: the wheel arrives over the very link that is
              missing.  -->
        <InfoBar
            x:Name="WheelBar"
            x:Uid="Mix_WheelBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <!--  The chat application is playing somewhere the mix cannot reach.
              Without this the wheel stops affecting chat and nothing says
              why.  -->
        <InfoBar
            x:Name="ElsewhereBar"
            x:Uid="Mix_ElsewhereBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--  Chosen: the crossfade itself, given room as the app's main
              control.  -->
        <Border
            x:Name="MixCard"
            Padding="20,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Uid="Mix_Game"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Slider
                    x:Name="MixSlider"
                    x:Uid="Mix_MixSlider"
                    Grid.Row="0"
                    Grid.Column="1"
                    Maximum="100"
                    Minimum="0"
                    TickFrequency="50"
                    TickPlacement="Outside" />

                <TextBlock
                    x:Uid="Mix_Chat"
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    x:Name="MixCaption"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!--  The mix keys sit beside the crossfade they move, not in Settings:
              that is where someone wanting to reach it mid-game is looking.  -->
        <tk:SettingsExpander
            x:Name="KeysCard"
            x:Uid="Mix_KeysCard"
            Visibility="Collapsed">
            <tk:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE765;" />
            </tk:SettingsExpander.HeaderIcon>
            <ToggleSwitch x:Name="KeysOn" />
            <tk:SettingsExpander.Items>
                <tk:SettingsCard x:Name="GameRow" x:Uid="Mix_GameRow">
                    <Button x:Name="GameKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="ChatRow" x:Uid="Mix_ChatRow">
                    <Button x:Name="ChatKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="CentreRow" x:Uid="Mix_CentreRow">
                    <Button x:Name="CentreKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Uid="Mix_KeysResetRow">
                    <Button x:Name="KeysReset" x:Uid="Mix_KeysReset" />
                </tk:SettingsCard>
            </tk:SettingsExpander.Items>
        </tk:SettingsExpander>

        <tk:SettingsCard
            x:Name="ChosenCard"
            x:Uid="Mix_ChosenCard"
            Visibility="Collapsed">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8BD;" />
            </tk:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="ChosenPicker"
                    x:Uid="Mix_ChosenPicker"
                    MinWidth="200" />
                <Button x:Name="ChosenRefresh" x:Uid="Mix_Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </tk:SettingsCard>

        <InfoBar
            x:Name="Notice"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

    </StackPanel>
</UserControl>

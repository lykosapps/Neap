<Project>
  <PropertyGroup>
    <Product>Neap</Product>
    <Company>lykosapps</Company>
    <Authors>lykosapps</Authors>
    <Copyright>Copyright (c) 2026 lykosapps</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Checked, not just written: a doc comment that only half-covers a method
      is a build warning, same as an unused import (below, in .editorconfig).
      CS1591 (a public member with no comment at all) is left off; the rule
      here is that what is written is complete, not that everything must be.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Every Windows library the code calls is a system one, so it is loaded only
    from the system folder: a file of the same name dropped beside Neap.exe,
    in a download folder say, is never picked up in its place.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.DefaultDllImportSearchPathsAttribute">
      <_Parameter1>System.Runtime.InteropServices.DllImportSearchPath.System32</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

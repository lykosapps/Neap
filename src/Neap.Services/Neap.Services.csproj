  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Neap.Services</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neap.Core\Neap.Core.csproj" />

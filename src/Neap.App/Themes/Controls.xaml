<?xml version="1.0" encoding="utf-8" ?>
<!--
    Windows' own controls in Neap's colours: the page frame, settings rows,
    buttons, lists, text fields, sliders, and the pop-ups, menus, tooltips
    and dialogs that open over them.
    
    It is merged into the app's resources after Windows' control styles,
    which later dictionaries override, and again on the navigation view. The
    toolkit's settings rows take their style from their own library, which
    looks for colours in its own dictionary before the app's, so for them
    only resources on an ancestor are looked in first. Pop-ups open outside
    the navigation view, so for them only the app's copy applies.
    
    High contrast keeps Windows' own colours throughout. Its dictionary is
    here and empty on purpose: with none, a contrast theme falls back to the
    light one's colours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <!--
        Left at the shared corner radius, a check box's indicator rounds into
        a circle indistinguishable from a radio button's, so a multi-choice
        list reads as an exclusive one. A smaller radius keeps it a square
        with rounded corners, so a check box always looks like one.
    -->
    <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">22</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">11</CornerRadius>


<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Controls_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <c:HeadsetSection x:Uid="Controls_Section">
                    <!--
                        The two controls on the headset that can be given a job, side by
                        side, each with every job it can do in view rather than behind a
                        list.
                    -->
                    <TextBlock x:Uid="Controls_OnHeadsetHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:ModeButtonChoice x:Uid="Controls_ModeButton" />
                        <c:SettingChoice
                            x:Uid="Controls_LowerDial"
                            Grid.Column="1"
                            Setting="dial_function" />
                    </Grid>

                    <!--
                        What the other controls do. They cannot be changed, so they are
                        said rather than offered, in one panel for reference.
                    -->
                    <TextBlock x:Uid="Controls_FixedHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource QuickCardStyle}">
                        <Grid ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="Controls_VolumeWheel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Controls_VolumeWheelDoes"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="Controls_ChatWheel"
                                Grid.Row="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Controls_ChatWheelDoes"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="Controls_BoomArm"
                                Grid.Row="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Controls_BoomArmDoes"
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="Controls_CrossPlay"
                                Grid.Row="3"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Controls_CrossPlayDoes"
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Uid="Controls_BluetoothButton"
                                Grid.Row="4"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Controls_BluetoothButtonDoes"
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </c:HeadsetSection>

                <!--
                    The keyboard moves the mix as the chat wheel does, so its
                    shortcuts sit with the headset's controls. Neap listens for
                    them itself, so they stay whether the headset is on or off.
                -->
                <TextBlock x:Uid="Controls_KeyboardHeading" Style="{StaticResource SectionHeaderStyle}" />
                <c:MixKeysPanel />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

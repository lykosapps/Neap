<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Audio_Title" Style="{StaticResource PageTitleStyle}" />

                <c:HeadsetNotice />

                <!--
                    With the headset off, the whole page is one card: Windows'
                    volume goes on working without it, but on nothing the person
                    can hear. See HeadsetSection.WhenOff.
                    
                    The settings changed from one moment to the next come first
                    and the equaliser last, as on Microphone: it is changed now
                    and then, and first it would fill a laptop's whole view.
                -->
                <c:HeadsetSection x:Uid="Audio_Section" WhenOff="True">
                    <!--
                        Noise control with its three modes, and Superhuman Hearing as
                        Home's tile, side by side, with how strong each is under it
                        while it is on.
                    -->
                    <c:HeadsetSection x:Uid="Audio_HeadsetSection">
                        <TextBlock x:Uid="Audio_AroundYouHeading" Style="{StaticResource SectionHeaderStyle}" />
                        <c:SideBySide>
                            <c:NoiseControlPanel />
                            <c:SettingTile
                                x:Uid="Audio_ShhTile"
                                Glyph="&#xF270;"
                                Setting="superhuman_hearing">
                                <StackPanel>
                                    <c:SettingRow
                                        x:Uid="Audio_Type"
                                        AsButtons="True"
                                        Setting="shh_preset"
                                        Style="{StaticResource NeapDrawerRowStyle}" />
                                    <c:SettingRow
                                        x:Uid="Audio_Intensity"
                                        Setting="shh_level"
                                        Style="{StaticResource NeapDrawerRowStyle}" />
                                </StackPanel>
                            </c:SettingTile>
                        </c:SideBySide>
                    </c:HeadsetSection>

                    <!--
                        Windows' own volume, with its mute beside it on one line,
                        and the headset's spoken alerts beside it, so every level
                        is in one place and neither row is a wide card with a
                        short slider. Windows' spatial sound under them, as a row
                        like theirs: the same control as Home's tile, so the two
                        can never say something different.
                    -->
                    <TextBlock x:Uid="Audio_VolumeHeading" Style="{StaticResource SectionHeaderStyle}" />
                    <c:RoutingNotice Margin="0,0,0,8" Microphone="False" />
                    <c:SideBySide>
                        <c:WindowsVolumeRow
                            x:Uid="Audio_MasterVolume"
                            Glyph="&#xE767;"
                            Kind="Volume"
                            WithMute="True" />
                        <c:HeadsetSection Explain="False">
                            <c:SettingRow
                                x:Uid="Audio_VoicePrompts"
                                Glyph="&#xE8BD;"
                                Setting="voice_prompt_volume" />
                        </c:HeadsetSection>
                    </c:SideBySide>
                    <c:SpatialTile Margin="0,16,0,0" AsRow="True" />

                    <!--
                        Folds without a card of its own: the card that stands in
                        for noise control above already names the equaliser.
                    -->
                    <c:HeadsetSection Explain="False">
                        <TextBlock
                            x:Name="EqualiserHeading"
                            x:Uid="Audio_EqualiserHeading"
                            Style="{StaticResource SectionHeaderStyle}" />
                        <c:EqualiserPanel Bank="Game" />
                    </c:HeadsetSection>
                </c:HeadsetSection>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Settings_Title" Style="{StaticResource PageTitleStyle}" />

                <!--
                    Neap itself, and whether it is up to date, first: the
                    update banner and the notice by the clock both lead
                    here, so what they promise is the first thing seen. On
                    the same lit panel as the headset's controls.
                -->
                <Border Style="{StaticResource QuickCardStyle}">
                    <Grid
                        x:Name="NeapCard"
                        RowSpacing="16"
                        SizeChanged="OnCardSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                Source="ms-appx:///Assets/logo.png" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        x:Name="AppName"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="AppVersion"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource NeapLabelStyle}"
                                        Visibility="Collapsed" />
                                </StackPanel>

                                <!--  Said when it changes, not as a download's percentage ticks over.  -->
                                <TextBlock
                                    x:Name="UpdateStatus"
                                    Margin="0,6,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            x:Name="UpdateActions"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="WhatsNew"
                                x:Uid="Settings_UpdateNotes"
                                Visibility="Collapsed" />
                            <Button x:Name="DownloadPage" Visibility="Collapsed" />
                            <Button x:Name="UpdateButton" />
                        </StackPanel>

                    </Grid>
                </Border>

                <StackPanel Margin="0,4,0,0" Spacing="4">
                    <tk:SettingsCard x:Uid="Settings_CheckForUpdates">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="CheckForUpdates" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="Settings_StartWithWindows">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartWithWindows" />
                    </tk:SettingsCard>
                </StackPanel>

                <TextBlock x:Uid="Settings_DiagnosticsHeading" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Spacing="4">
                    <tk:SettingsCard x:Name="Record" x:Uid="Settings_Record">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RecordHelp" x:Uid="Settings_RecordHelp">
                                <FontIcon Glyph="&#xE897;" />
                            </Button>
                            <Button
                                x:Name="ReportRecording"
                                x:Uid="Settings_RecordReport"
                                Visibility="Collapsed" />
                            <Button x:Name="RecordButton" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        x:Name="MapHeadset"
                        x:Uid="Settings_MapHeadset"
                        IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F6;" />
                        </tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </tk:SettingsCard.ActionIcon>
                    </tk:SettingsCard>
                </StackPanel>

                <!--  What has to be said and nothing a card could say instead, last and quiet.  -->
                <TextBlock
                    x:Uid="Settings_Legal"
                    MaxWidth="760"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Settings_Title" Style="{StaticResource PageTitleStyle}" />

                <TextBlock x:Uid="Settings_RunningHeading" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Uid="Settings_RunningNote" Style="{StaticResource SectionNoteStyle}" />
                <StackPanel Spacing="4">
                    <tk:SettingsCard x:Uid="Settings_StartWithWindows">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartWithWindows" />
                    </tk:SettingsCard>

                </StackPanel>

                <TextBlock x:Uid="Settings_AboutHeading" Style="{StaticResource SectionHeaderStyle}" />
                <!--  Neap itself, on the same lit panel as the headset's controls.  -->
                <Border Style="{StaticResource QuickCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="56"
                            Height="56"
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/logo.png" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="AppName" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="AppVersion"
                                Style="{StaticResource NeapLabelStyle}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Uid="Settings_AboutNote"
                                Margin="0,4,0,0"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Settings_Title" Style="{StaticResource PageTitleStyle}" />

                <TextBlock x:Uid="Settings_RunningHeading" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Uid="Settings_RunningNote" Style="{StaticResource SectionNoteStyle}" />
                <StackPanel Spacing="4">
                    <tk:SettingsCard x:Uid="Settings_StartWithWindows">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartWithWindows" />
                    </tk:SettingsCard>

                </StackPanel>

                <TextBlock x:Uid="Profiles_Heading" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Uid="Profiles_Note" Style="{StaticResource SectionNoteStyle}" />
                <c:ProfilesSettings />

                <TextBlock x:Uid="Settings_DiagnosticsHeading" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Spacing="4">
                    <tk:SettingsCard x:Name="Record" x:Uid="Settings_Record">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C8;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RecordHelp" x:Uid="Settings_RecordHelp">
                                <FontIcon Glyph="&#xE897;" />
                            </Button>
                            <Button
                                x:Name="ReportRecording"
                                x:Uid="Settings_RecordReport"
                                Visibility="Collapsed" />
                            <Button x:Name="RecordButton" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        x:Name="MapHeadset"
                        x:Uid="Settings_MapHeadset"
                        IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F6;" />
                        </tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </tk:SettingsCard.ActionIcon>
                    </tk:SettingsCard>
                </StackPanel>

                <TextBlock x:Uid="Settings_AboutHeading" Style="{StaticResource SectionHeaderStyle}" />
                <!--  Neap itself, on the same lit panel as the headset's controls.  -->
                <Border Style="{StaticResource QuickCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="56"
                            Height="56"
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/logo.png" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="AppName" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="AppVersion"
                                Style="{StaticResource NeapLabelStyle}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Uid="Settings_AboutNote"
                                Margin="0,4,0,0"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Margin="0,4,0,0" Spacing="4">
                    <tk:SettingsCard x:Name="Updates" x:Uid="Settings_Updates">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReleasePage" Visibility="Collapsed" />
                            <Button x:Name="UpdateButton" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="Settings_CheckForUpdates">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="CheckForUpdates" />
                    </tk:SettingsCard>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

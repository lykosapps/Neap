<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Neap.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls">

    <ScrollViewer
        Padding="32,0,32,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Style="{StaticResource PageColumnStyle}">

                <TextBlock x:Uid="Profiles_Title" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="Profiles_Note" Style="{StaticResource SectionNoteStyle}" />

                <!--
                    Saving the headset's settings as a profile is the same
                    action as New profile in the header's menu, which stays
                    where it is for the quick case. The notice says why the
                    button is off while the headset is not answering.
                -->
                <StackPanel
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button x:Name="New" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock
                        x:Name="Notice"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <c:ProfilesSettings />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

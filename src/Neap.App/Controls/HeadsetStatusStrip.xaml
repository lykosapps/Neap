<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.HeadsetStatusStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A dot and a word, and nothing else. Link, route, Bluetooth, signal
        and battery belong on Home: in a strip this size each added fact
        makes the others harder to read. The title bar says only whether to
        go and look.
    -->
    <StackPanel
        x:Name="ConnectionGroup"
        Orientation="Horizontal"
        Spacing="8">
        <Ellipse
            x:Name="ConnectionDot"
            Width="8"
            Height="8"
            VerticalAlignment="Center"
            Style="{StaticResource ToneCautionStyle}" />
        <TextBlock
            x:Name="ConnectionText"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</UserControl>

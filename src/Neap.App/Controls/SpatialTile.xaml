<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.SpatialTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <!--
        Windows' spatial sound for the headset, as a tile: lit while it is
        anything but off, the same as every other tile that can be on. The
        format shows as its word, and the flyout lists what Windows offers,
        opened from the tile like the equaliser's, or from a row's button
        beside the other levels.
    -->
    <Grid>
        <ToggleButton
            x:Name="Face"
            x:Uid="Quick_SpatialTile"
            IsEnabled="False"
            Style="{StaticResource NeapToggleTileStyle}">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="FormatFlyout" Placement="BottomEdgeAlignedRight">
                    <StackPanel MaxWidth="240" Spacing="8">
                        <ListView
                            x:Name="FormatList"
                            x:Uid="Quick_SpatialList"
                            MinWidth="200"
                            SelectionMode="Single" />
                        <!--  Dolby Atmos needs its driver before Windows offers it at all; see DriverNote below.  -->
                        <TextBlock
                            x:Name="DriverNote"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <!--  Dolby Access has its own equaliser, which can double up with the headset's; see EqualizerNote below.  -->
                        <TextBlock
                            x:Name="EqualizerNote"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="24"
                    Glyph="&#xF4C3;" />
                <TextBlock
                    x:Uid="Quick_Spatial"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <TextBlock
                    x:Name="Word"
                    Grid.Row="2"
                    Style="{StaticResource NeapTileStateStyle}" />
            </Grid>
        </ToggleButton>

        <tk:SettingsCard
            x:Name="Row"
            x:Uid="Spatial_Row"
            Visibility="Collapsed">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xF4C3;" />
            </tk:SettingsCard.HeaderIcon>
            <DropDownButton
                x:Name="RowButton"
                x:Uid="Spatial_RowButton"
                MinWidth="160"
                HorizontalContentAlignment="Left"
                IsEnabled="False" />
        </tk:SettingsCard>
    </Grid>
</UserControl>

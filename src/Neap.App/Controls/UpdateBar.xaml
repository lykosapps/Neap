<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.UpdateBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    Visibility="Collapsed">

    <!--
        A flat wash of the accent hue, with an accent edge down its left, so
        the news reads as temporary and not as part of the profile bar
        beneath it, whose own ground fades from the top. High contrast keeps
        the window's plain colour and the edge. One row at any width: the message wraps, and the buttons give
        way to a menu when the window is narrow.
    -->
    <Grid>
        <Border
            Padding="16,8"
            Background="{ThemeResource NeapNoticeBrush}"
            BorderBrush="{ThemeResource NeapPanelStrokeBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE946;" />

                <!--
                    The message and the download's progress. Takes keyboard
                    focus, while an update runs, from the buttons it takes away.
                -->
                <ContentControl
                    x:Name="Status"
                    Grid.Column="1"
                    Margin="-6,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    IsTabStop="False"
                    UseSystemFocusVisuals="True">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="Message"
                            AutomationProperties.LiveSetting="Polite"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            x:Name="Progress"
                            Maximum="100"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ContentControl>

                <StackPanel
                    x:Name="Actions"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="Notes" x:Uid="Settings_UpdateNotes" />
                    <Button x:Name="Act" Style="{StaticResource AccentButtonStyle}" />
                    <DropDownButton x:Name="NotNow" x:Uid="Banner_UpdateNotNow" />
                    <Button x:Name="More" x:Uid="Banner_UpdateMore">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Width="4"
            HorizontalAlignment="Left"
            Background="{ThemeResource AccentFillColorDefaultBrush}" />
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.MixKeysPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <StackPanel>
        <tk:SettingsCard x:Uid="Mix_KeysCard" Canvas.ZIndex="1">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE765;" />
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="KeysOn" />
        </tk:SettingsCard>

        <!--
            The keys themselves, as rows rather than folded away, and only
            while they are on, in a drawer under the switch: set once, and
            worth seeing while they work.
        -->
        <Border x:Name="KeyRows" Style="{StaticResource NeapDrawerStyle}">
            <StackPanel>
                <tk:SettingsCard
                    x:Name="GameRow"
                    x:Uid="Mix_GameRow"
                    Style="{StaticResource NeapDrawerRowStyle}">
                    <Button x:Name="GameKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard
                    x:Name="ChatRow"
                    x:Uid="Mix_ChatRow"
                    Style="{StaticResource NeapDrawerRowStyle}">
                    <Button x:Name="ChatKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard
                    x:Name="CentreRow"
                    x:Uid="Mix_CentreRow"
                    Style="{StaticResource NeapDrawerRowStyle}">
                    <Button x:Name="CentreKey" MinWidth="190" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Uid="Mix_KeysResetRow" Style="{StaticResource NeapDrawerRowStyle}">
                    <Button x:Name="KeysReset" x:Uid="Mix_KeysReset" />
                </tk:SettingsCard>
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="Notice"
            Margin="0,4,0,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />
    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.MixKeysPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="4">
        <tk:SettingsCard x:Uid="Mix_KeysCard">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE765;" />
            </tk:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="KeysOn" />
        </tk:SettingsCard>

        <!--
            The keys themselves, as rows rather than folded away, and only
            while they are on: set once, and worth seeing while they work.
        -->
        <StackPanel x:Name="KeyRows" Spacing="4">
            <tk:SettingsCard x:Name="GameRow" x:Uid="Mix_GameRow">
                <Button x:Name="GameKey" MinWidth="190" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="ChatRow" x:Uid="Mix_ChatRow">
                <Button x:Name="ChatKey" MinWidth="190" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="CentreRow" x:Uid="Mix_CentreRow">
                <Button x:Name="CentreKey" MinWidth="190" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Uid="Mix_KeysResetRow">
                <Button x:Name="KeysReset" x:Uid="Mix_KeysReset" />
            </tk:SettingsCard>
        </StackPanel>

        <InfoBar
            x:Name="Notice"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />
    </StackPanel>
</UserControl>

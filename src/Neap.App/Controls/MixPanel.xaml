<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.MixPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls">

    <StackPanel Spacing="12">

        <TextBlock
            x:Uid="Mix_Title"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource NeapLabelStyle}" />

        <!--
            The chat wheel cannot reach the app, with what still moves the
            mix. Inside the mix, not in a note elsewhere, so wherever the mix
            is shown the reason comes with it.
        -->
        <InfoBar
            x:Name="WheelBar"
            x:Uid="Mix_WheelBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational" />

        <!--
            The chat application is playing somewhere the mix cannot reach.
            Without this the wheel stops affecting chat and nothing says
            why.
        -->
        <InfoBar
            x:Name="ElsewhereBar"
            x:Uid="Mix_ElsewhereBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--
            Nothing chosen yet: only the question. The dial means nothing
            until it is answered, so it is absent rather than disabled.
        -->
        <TextBlock
            x:Name="SetupLine"
            x:Uid="Mix_Setup"
            Style="{StaticResource SecondaryBodyTextStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Chosen: the knob, with how loud each side plays on its cap.  -->
        <Grid
            x:Name="DialArea"
            Margin="0,0,0,14"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <c:GameChatDial x:Name="Dial" x:Uid="Mix_Dial" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="2">
                <TextBlock
                    x:Name="LeanText"
                    HorizontalAlignment="Center"
                    CharacterSpacing="60"
                    Style="{StaticResource SecondaryCaptionTextStyle}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock
                        x:Name="GameLevel"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource NeapGameTextBrush}"
                        Style="{StaticResource NumeralTextStyle}" />
                    <TextBlock
                        x:Name="ChatLevel"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource NeapChatTextBrush}"
                        Style="{StaticResource NumeralTextStyle}" />
                </StackPanel>
            </StackPanel>

            <!--  Under each end of the ring: which side is which.  -->
            <TextBlock
                x:Uid="Mix_Game"
                Margin="36,0,0,-14"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                CharacterSpacing="80"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NeapGameTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Uid="Mix_Chat"
                Margin="0,0,36,-14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CharacterSpacing="80"
                FontWeight="SemiBold"
                Foreground="{ThemeResource NeapChatTextBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!--
            Which applications carry chat: the only thing the mix needs to
            know. Folded to a line naming them once chosen, and open until
            then, because the choice is the question the panel is asking.
        -->
        <Expander
            x:Name="ChatFrom"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <StackPanel Padding="0,8" Spacing="2">
                    <TextBlock x:Uid="Mix_ChatFrom" Style="{StaticResource SecondaryCaptionTextStyle}" />
                    <TextBlock x:Name="ChosenText" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="8">
                <StackPanel x:Name="AppList" />
                <!--
                    Only applications with sound open on the headset are
                    listed, so one not yet started is missing. The notice
                    below says so instead when nothing is listed at all.
                -->
                <TextBlock
                    x:Name="MissingHint"
                    x:Uid="Mix_MissingHint"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="Notice"
                    x:Uid="Mix_NothingPlaying"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational" />
                <Button x:Name="Refresh" x:Uid="Mix_Refresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="Mix_RefreshText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Expander>

    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.TransmittersPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The transmitter in use first, on its own panel across the width with
        its lights inside it, then the others and Bluetooth, two to a row.
    -->
    <StackPanel>
        <TextBlock x:Uid="Transmitters_Heading" Style="{StaticResource SectionHeaderStyle}" />
        <TextBlock x:Uid="Transmitters_Note" Style="{StaticResource SectionNoteStyle}" />
        <StackPanel Spacing="12">
            <ContentPresenter x:Name="InUse" />
            <Grid
                x:Name="Others"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The equaliser's plots, band and parametric. Their shapes are built in
        code, so their colours are styles rather than brushes set in code:
        a style's theme resources follow a change of theme or contrast while
        the page is open. Dash patterns stay in code: a style shares one
        pattern between its lines, and only the first line draws it.
    -->

    <!--  The quarter lines, faint, and the 0 dB line, stronger.  -->
    <Style x:Key="CurveGridStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="CurveCentreStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!--  Where each of the headset's bands sits along the bottom.  -->
    <Style x:Key="CurveBandTickStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!--  The curve the headset plays, and the band view's fill beneath it.  -->
    <Style x:Key="CurveHeardStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>
    <Style x:Key="CurveAreaStyle" TargetType="Path">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.14" />
    </Style>

    <!--  The parametric curve asked for, and the gap between it and the curve heard.  -->
    <Style x:Key="CurveAskedStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="CurveGapStyle" TargetType="Path">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!--  The band view's preset, drawn behind the curve once a band has moved, and its ring on each moved band.  -->
    <Style x:Key="CurveStoredStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="CurveRingStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource SettingsCardBackground}" />
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!--  The band view's point on each band.  -->
    <Style x:Key="CurveBandHandleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource SettingsCardBackground}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!--  A parametric adjustment's numbered point: filled when it is the one the fields show.  -->
    <Style x:Key="CurveHandleStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource SettingsCardBackground}" />
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="CurveHandleChosenStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource SettingsCardBackground}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="CurveHandleNumberStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="CurveHandleChosenNumberStyle"
        BasedOn="{StaticResource CurveHandleNumberStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!--  The test tone's line and dot, and the tag above them with its frequency.  -->
    <Style x:Key="CurveToneLineStyle" TargetType="Line">
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="CurveToneDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="CurveToneTagStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1,6,2" />
    </Style>
    <Style x:Key="CurveToneTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The tiles on Home: big buttons that press in, after Windows' Quick
        Settings. A setting that is on fills its tile with the accent; the
        equaliser is not on or off, so its tile never fills and opens a list
        instead. High contrast uses the system's button and highlight
        colours, and the fill still says which is on.
        
        A tile that can't be changed, such as the microphone while the boom
        arm mutes it, is drawn in its own quieter colours rather than faded:
        its state still has to be read, so its text keeps 4.5:1.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <LinearGradientBrush x:Key="NeapTileBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#342C48" />
                <GradientStop Offset="1" Color="#2A233B" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapTileHoverBrush" Color="#3A3150" />
            <SolidColorBrush x:Key="NeapTileStrokeBrush" Color="#45395F" />
            <SolidColorBrush x:Key="NeapTileEdgeBrush" Color="#66000000" />
            <SolidColorBrush x:Key="NeapTileTextBrush" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="NeapTileOnBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#AB9CFF" />
                <GradientStop Offset="1" Color="#9181F6" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapTileOnHoverBrush" Color="#B4A7FF" />
            <SolidColorBrush x:Key="NeapTileOnStrokeBrush" Color="#C3B8FF" />
            <SolidColorBrush x:Key="NeapTileOnEdgeBrush" Color="#4A3AA8" />
            <SolidColorBrush x:Key="NeapTileOnTextBrush" Color="#15112A" />
            <SolidColorBrush x:Key="NeapPresetSelectedBrush" Color="#269D8CFF" />
            <SolidColorBrush x:Key="NeapPresetHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NeapTileDisabledBrush" Color="#272137" />
            <SolidColorBrush x:Key="NeapTileDisabledStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapTileDisabledTextBrush" Color="#B3AEC2" />
            <SolidColorBrush x:Key="NeapTileOnDisabledBrush" Color="#433A6E" />
            <SolidColorBrush x:Key="NeapTileOnDisabledTextBrush" Color="#D9D3FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="NeapTileBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#F0EDF7" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapTileHoverBrush" Color="#FAF9FD" />
            <SolidColorBrush x:Key="NeapTileStrokeBrush" Color="#DDD8E8" />
            <SolidColorBrush x:Key="NeapTileEdgeBrush" Color="#26000000" />
            <SolidColorBrush x:Key="NeapTileTextBrush" Color="#1A1A1A" />
            <LinearGradientBrush x:Key="NeapTileOnBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#614ECF" />
                <GradientStop Offset="1" Color="#5845BD" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeapTileOnHoverBrush" Color="#5C49C4" />
            <SolidColorBrush x:Key="NeapTileOnStrokeBrush" Color="#4C3BB0" />
            <SolidColorBrush x:Key="NeapTileOnEdgeBrush" Color="#40309A" />
            <SolidColorBrush x:Key="NeapTileOnTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeapPresetSelectedBrush" Color="#1F6D5AD9" />
            <SolidColorBrush x:Key="NeapPresetHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="NeapTileDisabledBrush" Color="#E6E3EE" />
            <SolidColorBrush x:Key="NeapTileDisabledStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapTileDisabledTextBrush" Color="#48474C" />
            <SolidColorBrush x:Key="NeapTileOnDisabledBrush" Color="#C9C1F0" />
            <SolidColorBrush x:Key="NeapTileOnDisabledTextBrush" Color="#2E2466" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NeapTileBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="NeapTileHoverBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="NeapTileStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="NeapTileEdgeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapTileTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="NeapTileOnBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NeapTileOnHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NeapTileOnStrokeBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NeapTileOnEdgeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapTileOnTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NeapPresetSelectedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapPresetHoverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NeapTileDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="NeapTileDisabledStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NeapTileDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NeapTileOnDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="NeapTileOnDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        A setting's tile. The edge under it is its depth; pressed, the tile
        drops onto it, so it feels pushed rather than only recoloured.
    -->
    <Style x:Key="NeapToggleTileStyle" TargetType="ToggleButton">
        <!--  In high contrast its own text colours hold against the highlight, so no backplate is drawn.  -->
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="Edge"
                            Margin="0,3,0,0"
                            Background="{ThemeResource NeapTileEdgeBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            x:Name="Face"
                            Margin="0,0,0,3"
                            Padding="{TemplateBinding Padding}"
                            Background="{ThemeResource NeapTileBrush}"
                            BorderBrush="{ThemeResource NeapTileStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Push" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                x:Name="Content"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{ThemeResource NeapTileTextBrush}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Push.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileDisabledBrush}" />
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NeapTileDisabledStrokeBrush}" />
                                        <Setter Target="Edge.Opacity" Value="0.55" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource NeapTileDisabledTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileOnBrush}" />
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NeapTileOnStrokeBrush}" />
                                        <Setter Target="Edge.Background" Value="{ThemeResource NeapTileOnEdgeBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource NeapTileOnTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileOnHoverBrush}" />
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NeapTileOnStrokeBrush}" />
                                        <Setter Target="Edge.Background" Value="{ThemeResource NeapTileOnEdgeBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource NeapTileOnTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileOnBrush}" />
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NeapTileOnStrokeBrush}" />
                                        <Setter Target="Edge.Background" Value="{ThemeResource NeapTileOnEdgeBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource NeapTileOnTextBrush}" />
                                        <Setter Target="Push.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileOnDisabledBrush}" />
                                        <Setter Target="Face.BorderBrush" Value="{ThemeResource NeapTileDisabledStrokeBrush}" />
                                        <Setter Target="Edge.Opacity" Value="0.55" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource NeapTileOnDisabledTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The equaliser's tile: the same shape, never filled, opening a list.  -->
    <Style x:Key="NeapButtonTileStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Margin="0,3,0,0"
                            Background="{ThemeResource NeapTileEdgeBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            x:Name="Face"
                            Margin="0,0,0,3"
                            Padding="{TemplateBinding Padding}"
                            Background="{ThemeResource NeapTileBrush}"
                            BorderBrush="{ThemeResource NeapTileStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Push" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{ThemeResource NeapTileTextBrush}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapTileHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Push.Y" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A tile's name and its state, under its icon.  -->
    <Style
        x:Key="NeapTileTitleStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="NeapTileStateStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  The small curve beside a preset's name.  -->
    <Style x:Key="NeapMiniCurveStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{ThemeResource NeapGameTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!--
        A preset in the equaliser's list, as in Home's list: a flat row, and
        the chosen one tinted and marked with the accent at its left edge,
        which is what still shows in high contrast.
    -->
    <Style x:Key="NeapPresetStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Face"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border
                            Width="3"
                            Margin="0,8"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="2" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Background" Value="{ThemeResource NeapPresetHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="NeapPresetChosenStyle"
        BasedOn="{StaticResource NeapPresetStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NeapPresetSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <!--
        A word beside a preset's name, such as "Parametric": outlined in the
        accent rather than filled, so it reads as a label and not a state.
    -->
    <Style x:Key="NeapTagStyle" TargetType="Border">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style
        x:Key="NeapTagTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>

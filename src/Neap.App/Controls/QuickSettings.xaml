<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.QuickSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls">

    <!--
        The settings reached for mid-game or mid-call, as tiles: the
        microphone and noise control side by side, the equaliser across the
        width under them with its curve, then Superhuman Hearing and
        Windows' spatial sound side by side last.
    -->
    <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:MicTile />

        <!--
            Noise control steps through its three modes in the order the Mode
            button does, and is lit for either mode that is not off.
        -->
        <ToggleButton
            x:Name="NoiseTile"
            x:Uid="Quick_NoiseTile"
            Grid.Column="1"
            IsEnabled="False"
            Style="{StaticResource NeapToggleTileStyle}">
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="24"
                    Glyph="&#xE7F6;" />
                <TextBlock
                    x:Uid="Quick_NoiseControl"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <TextBlock
                    x:Name="NoiseWord"
                    Grid.Row="2"
                    Style="{StaticResource NeapTileStateStyle}" />
            </Grid>
        </ToggleButton>

        <!--
            The equaliser is not on or off, so its tile never fills. It shows
            the curve it is on, says when that curve comes from adjustments,
            and opens the presets, each with its own curve, to pick one
            directly. Tuning is a sit-down job, so the list ends with the way
            to the equaliser rather than any of its controls.
        -->
        <Button
            x:Name="PresetPicker"
            x:Uid="Quick_PresetPicker"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsEnabled="False"
            Style="{StaticResource NeapButtonTileStyle}">
            <Button.Flyout>
                <Flyout x:Name="PresetFlyout" Placement="BottomEdgeAlignedRight">
                    <StackPanel MinWidth="260" Spacing="4">
                        <ListView
                            x:Name="PresetList"
                            x:Uid="Quick_PresetList"
                            SelectionMode="Single" />
                        <Border
                            Padding="0,4,0,0"
                            BorderBrush="{ThemeResource NeapPanelStrokeBrush}"
                            BorderThickness="0,1,0,0">
                            <Button
                                x:Name="OpenEqualiser"
                                x:Uid="Quick_OpenEqualiserButton"
                                Style="{StaticResource NeapPresetStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Quick_OpenEqualiser" VerticalAlignment="Center" />
                                    <FontIcon
                                        Grid.Column="1"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="12"
                                        Glyph="&#xE76C;" />
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="24"
                    Glyph="&#xE9E9;" />
                <FontIcon
                    Grid.Column="1"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Glyph="&#xE70D;" />
                <TextBlock
                    x:Uid="Quick_Preset"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="PresetName"
                        VerticalAlignment="Center"
                        Style="{StaticResource NeapTileStateStyle}" />
                    <Border
                        x:Name="ParametricTag"
                        Style="{StaticResource NeapTagStyle}"
                        Visibility="Collapsed">
                        <TextBlock x:Name="ParametricWord" Style="{StaticResource NeapTagTextStyle}" />
                    </Border>
                </StackPanel>
                <Path
                    x:Name="PresetCurve"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource NeapMiniCurveStyle}" />
            </Grid>
        </Button>

        <!--
            The one Audio setting made for the middle of a game: footsteps
            and quiet sounds. Its type and strength stay on Audio.
        -->
        <ToggleButton
            x:Name="ShhTile"
            x:Uid="Quick_ShhTile"
            Grid.Row="2"
            IsEnabled="False"
            Style="{StaticResource NeapToggleTileStyle}">
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="24"
                    Glyph="&#xF270;" />
                <TextBlock
                    x:Uid="Quick_Shh"
                    Grid.Row="1"
                    Style="{StaticResource NeapTileTitleStyle}" />
                <TextBlock
                    x:Name="ShhWord"
                    Grid.Row="2"
                    Style="{StaticResource NeapTileStateStyle}" />
            </Grid>
        </ToggleButton>

        <!--  Windows' spatial sound on the headset: a Windows setting, reached from Home like the others.  -->
        <c:SpatialTile Grid.Row="2" Grid.Column="1" />
    </Grid>
</UserControl>

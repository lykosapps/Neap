<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Neap.App.Controls.EqualiserPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <!--
        The curve and its controls across the whole of a lit panel like
        Home's, with the presets opening from the preset's name, as they
        open from Home's tile.
    -->
    <Border Style="{StaticResource QuickCardStyle}">
        <StackPanel Spacing="16">

            <!--  Which preset, and whether it has been changed since.  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--
                        The name is the way to the other presets. It keeps
                        the title's size and loses the button's fill, so it
                        still reads as the heading until pointed at.
                    -->
                    <DropDownButton
                        x:Name="PresetPicker"
                        x:Uid="Equaliser_PresetPicker"
                        Margin="-10,0,0,0"
                        Padding="10,2,8,4"
                        Background="Transparent"
                        BorderBrush="Transparent">
                        <TextBlock x:Name="PresetName" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <DropDownButton.Flyout>
                            <Flyout x:Name="PresetFlyout" Placement="BottomEdgeAlignedLeft">
                                <!--
                                    The slots, factory and custom, and how many are
                                    left: that is part of the decision to save.
                                -->
                                <StackPanel MinWidth="280" Spacing="4">
                                    <TextBlock
                                        x:Uid="Equaliser_PresetsLabel"
                                        Margin="12,0,0,8"
                                        Style="{StaticResource NeapLabelStyle}" />
                                    <ItemsControl x:Name="Slots" />
                                    <!--
                                        A new preset from flat, without choosing and
                                        changing one first. Unavailable with every slot
                                        full, as the note under it says.
                                    -->
                                    <Button
                                        x:Name="NewButton"
                                        x:Uid="Equaliser_New"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource NeapPresetStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                                            <TextBlock x:Uid="Equaliser_NewLabel" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        x:Name="FreeSlots"
                                        Margin="12,8,12,0"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Border
                        x:Name="EditedPill"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Uid="Equaliser_Edited"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>

                <!--
                    Always there, and disabled when they cannot be used, so
                    none moves under the pointer when a band is first
                    dragged. Overwrite goes first because its label names
                    the preset and changes width; the two after it stay put.
                    It is left out for a factory preset, which can never be
                    overwritten. Saving a new preset is the accent once there
                    is an edit to keep, since it keeps everything where
                    overwriting loses the old curve; before that it offers a
                    duplicate, which is not the thing to do next, and is plain.
                -->
                <StackPanel
                    x:Name="Actions"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="OverwriteButton" IsEnabled="False">
                        <Button.Flyout>
                            <Flyout x:Name="OverwriteConfirm">
                                <StackPanel MaxWidth="280" Spacing="12">
                                    <TextBlock
                                        x:Name="OverwriteQuestion"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button x:Name="OverwriteYes" x:Uid="Equaliser_OverwriteYes" />
                                        <Button x:Name="OverwriteNo" x:Uid="Equaliser_OverwriteNo" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="DiscardButton"
                        x:Uid="Equaliser_DiscardButton"
                        IsEnabled="False" />
                    <Button
                        x:Name="SaveButton"
                        MinWidth="104"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>


            <!--
                How the curve is shaped: band by band, or by adjustments
                fitted to the bands. Only the game bank has the second.
            -->
            <RadioButtons
                x:Name="Mode"
                x:Uid="Equaliser_Mode"
                MaxColumns="2"
                Visibility="Collapsed">
                <RadioButton x:Name="ModeBands" x:Uid="Equaliser_ModeBands" />
                <RadioButton x:Name="ModeParametric" x:Uid="Equaliser_ModeParametric">
                    <!--
                        Asked first, in place, when choosing Parametric would
                        change what is heard, with the safe answer focused.
                    -->
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="ParametricConfirm">
                            <StackPanel MaxWidth="280" Spacing="12">
                                <TextBlock
                                    x:Name="ParametricQuestion"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button x:Name="ParametricYes" x:Uid="Equaliser_ParametricYes" />
                                    <Button x:Name="ParametricNo" x:Uid="Equaliser_ParametricNo" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </RadioButton>
            </RadioButtons>

            <!--
                Parametric and the curve take the panel's whole width, so
                they line up with the preset's name above them.
            -->
            <c:ParametricPanel
                x:Name="Parametric"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed" />

            <!--
                The curve and the readouts share one width and one set of
                columns, so every point sits over its own number, until the
                panel is too narrow for ten readable values; then they fold
                into two rows of five.
            -->
            <StackPanel x:Name="Curve" HorizontalAlignment="Stretch">
                <c:EqualiserCurve x:Name="Response" Height="220" />
                <Grid
                    x:Name="Bands"
                    Margin="0,8,0,0"
                    RowSpacing="8" />
            </StackPanel>

            <!--
                Shown until the headset reports its bands, in place of the
                curve: a flat line would read as an equaliser set flat.
            -->
            <StackPanel
                x:Name="Waiting"
                Padding="0,24"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <ProgressRing
                    x:Name="WaitingRing"
                    Width="20"
                    Height="20"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="WaitingText" Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>

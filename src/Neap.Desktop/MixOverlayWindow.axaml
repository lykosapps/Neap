<Window
    x:Class="Neap.Desktop.MixOverlayWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Neap.Desktop.Localization"
    Classes="mini"
    CanResize="False"
    Focusable="False"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    Background="Transparent">

    <Window.Styles>
        <Style Selector="Rectangle#Fill.game">
            <Setter Property="Fill" Value="{DynamicResource NeapGameBrush}" />
        </Style>
        <Style Selector="Rectangle#Fill.chat">
            <Setter Property="Fill" Value="{DynamicResource NeapChatBrush}" />
        </Style>
    </Window.Styles>

    <!--
        The mini panel's mix made into a picture, in one row no bigger than
        the system's own volume flyout: its two ends either side of a track
        filled from the middle toward the side the mix leans to, with a mark
        where it sits. Nothing in it takes a click or the keyboard.
    -->
    <Border
        Height="32"
        Padding="12,0"
        Classes="card"
        CornerRadius="16"
        IsHitTestVisible="False">
        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{StaticResource NeapSpaceS}">
            <TextBlock
                VerticalAlignment="Center"
                loc:Uid.Value="Mix_Game"
                Classes="label"
                Foreground="{DynamicResource NeapGameTextBrush}" />
            <Canvas
                x:Name="Track"
                Width="60"
                Height="10"
                VerticalAlignment="Center">
                <Rectangle
                    Canvas.Top="3"
                    Width="60"
                    Height="4"
                    RadiusX="2"
                    RadiusY="2"
                    Fill="{DynamicResource NeapControlTrackBrush}" />
                <Rectangle
                    x:Name="Fill"
                    Canvas.Top="3"
                    Height="4"
                    RadiusX="2"
                    RadiusY="2" />
                <Ellipse
                    x:Name="Mark"
                    Width="10"
                    Height="10"
                    Fill="{DynamicResource NeapSliderThumbBrush}" />
            </Canvas>
            <TextBlock
                VerticalAlignment="Center"
                loc:Uid.Value="Mix_Chat"
                Classes="label"
                Foreground="{DynamicResource NeapChatTextBrush}" />
        </StackPanel>
    </Border>
</Window>

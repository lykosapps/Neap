<Window
    x:Class="Neap.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization"
    Width="1180"
    Height="900"
    MinWidth="500"
    MinHeight="480"
    Background="{DynamicResource NeapGroundBrush}"
    Icon="avares://Neap.Desktop/Assets/app.ico">

    <!--
        Neap's own ground behind everything, in place of the system's grey.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="{StaticResource NeapTitleBarHeight}" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The title row carries the headset's connection state, the one
            thing worth seeing from every tab; the readings are on Home.
            Right-aligned.
        -->
        <c:HeadsetStatusStrip
            x:Name="Status"
            HorizontalAlignment="Right"
            Margin="0,0,16,0"
            VerticalAlignment="Center" />

        <!--
            A newer version of Neap, at the very top under the title bar,
            above every page until it is installed or put away.
        -->
        <c:UpdateBar Grid.Row="1" />

        <SplitView
            x:Name="Rail"
            Grid.Row="2"
            CompactPaneLength="52"
            DisplayMode="CompactInline"
            IsPaneOpen="True"
            OpenPaneLength="220"
            PaneBackground="{DynamicResource NeapGroundBrush}">
            <SplitView.Pane>
                <DockPanel Margin="8">
                    <!--
                        The active profile, at the top of the menu: one move
                        from every page. Folds to one icon with the menu.
                    -->
                    <c:ProfileBar
                        x:Name="Profile"
                        Margin="4,0,4,8"
                        DockPanel.Dock="Top" />
                    <!-- Settings sits apart at the foot, as the Windows app has it. -->
                    <ListBox
                        x:Name="Foot"
                        Background="Transparent"
                        DockPanel.Dock="Bottom">
                        <c:NavItem
                            loc:Uid.Value="Main_NavSettings"
                            Icon="{StaticResource IconSettings}"
                            Page="settings" />
                    </ListBox>
                    <ListBox x:Name="Places" Background="Transparent">
                        <c:NavItem
                            loc:Uid.Value="Main_NavHome"
                            Icon="{StaticResource IconHome}"
                            Page="home" />
                        <c:NavItem
                            loc:Uid.Value="Main_NavAudio"
                            Icon="{StaticResource IconAudio}"
                            Page="audio" />
                        <c:NavItem
                            loc:Uid.Value="Main_NavEqualiser"
                            Icon="{StaticResource IconEqualiser}"
                            Page="equaliser" />
                        <c:NavItem
                            loc:Uid.Value="Main_NavControls"
                            Icon="{StaticResource IconControls}"
                            Page="controls" />
                        <c:NavItem
                            loc:Uid.Value="Main_NavProfiles"
                            Icon="{StaticResource IconProfile}"
                            Page="profiles" />
                        <c:NavItem
                            loc:Uid.Value="Main_NavDevice"
                            Icon="{StaticResource IconDevice}"
                            Page="device" />
                    </ListBox>
                </DockPanel>
            </SplitView.Pane>

            <Grid>
                <Border x:Name="PageFrame" Classes="pagebody">
                    <TransitioningContentControl x:Name="Body" />
                </Border>

                <!--
                    In a narrow window the menu folds into this button, over the
                    page's top corner, and opens over the page.
                -->
                <Button
                    x:Name="NavToggle"
                    Width="{StaticResource NeapTitleBarHeight}"
                    Height="{StaticResource NeapTitleBarHeight}"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    IsVisible="False"
                    loc:Uid.Value="Main_NavMenu">
                    <PathIcon Width="20" Height="20" Data="{StaticResource IconMenu}" />
                </Button>
            </Grid>
        </SplitView>
    </Grid>
</Window>

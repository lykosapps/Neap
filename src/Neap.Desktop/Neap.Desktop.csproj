<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Two builds: one for every system, and one for Windows that adds what only
      Windows itself can give (spatial sound). Publish the first with -f net10.0.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Neap.Desktop</RootNamespace>
    <AssemblyName>Neap.Desktop</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's own generated code is not held to the project's doc-comment rules. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Neap speaks one language, so it needs no culture data, and a system without the ICU library (a minimal one) still runs it. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Neap.Services" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neap.Core\Neap.Core.csproj" />
    <ProjectReference Include="..\Neap.Services\Neap.Services.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <ProjectReference Include="..\Neap.WinRt\Neap.WinRt.csproj" />
    <!-- The notification-area notification the old app shows, which needs no shortcut for Windows to attribute it to. -->
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
  </ItemGroup>

  <!--
    The graphics libraries bring debugging files for their native parts, 100 MB
    of them, which a person running the app has no use for.
  -->
  <Target Name="LeaveOutNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The words: one file, one copy of every sentence, for both systems. -->
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="Resources.resw" />
    <AvaloniaResource Include="Assets\logo.png" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

</Project>

<Application
    x:Class="Neap.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Neap.Desktop/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Neap.Desktop/Themes/Neap.axaml" />
        <StyleInclude Source="avares://Neap.Desktop/Themes/Dial.axaml" />
    </Application.Styles>
</Application>

<Window
    x:Class="Neap.Desktop.MiniPanelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization"
    Width="320"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    Background="Transparent">

    <Window.Styles>
        <!-- The preset picker sized to the panel's compact row. -->
        <Style Selector="c|PresetChoice">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        </Style>
    </Window.Styles>

    <!--
        The things changed mid-game: the mix, the microphone, noise
        cancellation, spatial sound and the equaliser preset. A card, as Home's are, drawn
        in a window of its own so it can sit by the notification area and
        go away when it loses focus.
    -->
    <Border Classes="card">
        <StackPanel Spacing="{StaticResource NeapSpaceM}">

            <!-- The headset, how it is connected, its battery, and the way to the window. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource NeapSpaceM}">
                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource NeapSpaceHairline}">
                    <TextBlock
                        x:Name="HeadsetName"
                        Classes="cardtitle"
                        AutomationProperties.HeadingLevel="1"
                        TextTrimming="CharacterEllipsis" />
                    <c:HeadsetStatusStrip HorizontalAlignment="Left" />
                </StackPanel>
                <ContentControl
                    x:Name="BatteryHolder"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="OpenNeap"
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="quiet"
                    loc:Uid.Value="Mini_Open">
                    <PathIcon
                        Width="{StaticResource NeapIconRow}"
                        Height="{StaticResource NeapIconRow}"
                        Data="{StaticResource IconLaunch}" />
                </Button>
            </Grid>

            <!--
                With the headset away the header's status says so, and the
                sections fold without explaining: the panel is for changing
                things mid-game, and the window has the detail.

                The mix goes on working with only the headset's settings out of
                reach, so it folds only when the headset is away. It is a slider
                here, Home's dial made small: game at the left, chat at the
                right. Without chat apps chosen there is nothing to mix, so the
                slider is disabled and the line below it says how to get one.
            -->
            <c:HeadsetSection Explain="False" WhenOff="True">
                <StackPanel x:Name="DialArea" Spacing="{StaticResource NeapSpaceXS}">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceXS}">
                            <TextBlock
                                loc:Uid.Value="Mix_Game"
                                Classes="label"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource NeapGameTextBrush}" />
                            <TextBlock
                                x:Name="GameLevel"
                                Classes="label"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource NeapGameTextBrush}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LeanText"
                            Grid.Column="1"
                            Classes="label secondary"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{StaticResource NeapSpaceXS}">
                            <TextBlock
                                x:Name="ChatLevel"
                                Classes="label"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource NeapChatTextBrush}" />
                            <TextBlock
                                loc:Uid.Value="Mix_Chat"
                                Classes="label"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource NeapChatTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <Slider
                        x:Name="Dial"
                        Classes="balance"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="10"
                        loc:Uid.Value="Mix_Dial" />
                </StackPanel>
                <StackPanel
                    x:Name="SetupArea"
                    Spacing="{StaticResource NeapSpaceXS}"
                    IsVisible="False">
                    <TextBlock loc:Uid.Value="Mix_Setup" Classes="caption secondary" TextWrapping="Wrap" />
                    <Button
                        x:Name="ChooseApps"
                        loc:Uid.Value="Mini_ChooseApps"
                        Classes="link" />
                </StackPanel>
            </c:HeadsetSection>

            <!--
                The settings changed mid-game, as quick tiles the way the
                system's quick settings are: a press turns one on or off, and a
                tile with more than one way of being on lists them from its
                corner. Spatial sound is the system's setting, not the headset's,
                but the panel is for the headset in use, so it folds away with
                the headset's settings rather than standing alone.
            -->
            <c:HeadsetSection Explain="False" Spacing="{StaticResource NeapSpaceS}">
                <UniformGrid Rows="1" ColumnSpacing="{StaticResource NeapSpaceS}">
                    <c:MicTile AsTile="True" />
                    <c:QuickTile x:Name="NoiseTile" />
                    <c:SpatialTile AsTile="True" />
                </UniformGrid>

                <Border Classes="quickrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource NeapSpaceS}">
                        <PathIcon
                            Classes="quickicon"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Data="{StaticResource IconEqualiser}" />
                        <TextBlock
                            Grid.Column="1"
                            loc:Uid.Value="Mini_Equaliser"
                            Classes="quicktitle"
                            VerticalAlignment="Center" />
                        <c:PresetChoice
                            x:Name="Preset"
                            Grid.Column="2"
                            MaxWidth="170"
                            loc:Uid.Value="Quick_PresetPicker" />
                    </Grid>
                </Border>
            </c:HeadsetSection>
        </StackPanel>
    </Border>
</Window>

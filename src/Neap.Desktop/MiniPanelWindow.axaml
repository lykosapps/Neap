<Window
    x:Class="Neap.Desktop.MiniPanelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization"
    Width="320"
    Classes="mini"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    Background="Transparent">

    <Window.Styles>
        <!-- The preset picker sized to the panel's compact row. -->
        <Style Selector="c|PresetChoice">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
        </Style>
    </Window.Styles>

    <!--
        The things changed mid-game: the mix, then the controls the person
        chose to show, from the microphone, noise cancellation, spatial sound,
        Superhuman Hearing and the equaliser preset. A card, as Home's are, drawn
        in a window of its own so it can sit by the notification area and
        go away when it loses focus.
    -->
    <Border Classes="card">
        <StackPanel Spacing="{StaticResource NeapSpaceM}">

            <!-- The headset, how it is connected, its battery, and the way to the window. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource NeapSpaceM}">
                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource NeapSpaceHairline}">
                    <TextBlock
                        x:Name="HeadsetName"
                        Classes="cardtitle"
                        AutomationProperties.HeadingLevel="1"
                        TextTrimming="CharacterEllipsis" />
                    <c:HeadsetStatusStrip x:Name="Status" HorizontalAlignment="Left" />
                </StackPanel>
                <ContentControl
                    x:Name="BatteryHolder"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="OpenNeap"
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="quiet"
                    loc:Uid.Value="Mini_Open">
                    <PathIcon
                        Width="{StaticResource NeapIconRow}"
                        Height="{StaticResource NeapIconRow}"
                        Data="{StaticResource IconLaunch}" />
                </Button>
            </Grid>

            <!--
                With the headset away the header's status says so, and the
                sections fold without explaining: the panel is for changing
                things mid-game, and the window has the detail.

                The mix goes on working with only the headset's settings out of
                reach, so it folds only when the headset is away. It is a slider
                here, Home's dial made small: game at the left, chat at the
                right. Without chat apps chosen there is nothing to mix, so a
                link to choose them stands in for the slider.
            -->
            <c:HeadsetSection Explain="False" WhenOff="True">
                <!-- Its two ends, and nothing more: where the thumb sits says the balance, and a screen reader hears the levels. -->
                <StackPanel x:Name="DialArea" Spacing="{StaticResource NeapSpaceS}">
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock
                            loc:Uid.Value="Mix_Game"
                            Classes="label"
                            Foreground="{DynamicResource NeapGameTextBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            loc:Uid.Value="Mix_Chat"
                            Classes="label"
                            Foreground="{DynamicResource NeapChatTextBrush}" />
                    </Grid>
                    <Slider
                        x:Name="Dial"
                        Margin="0,-12"
                        Classes="balance"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="10"
                        loc:Uid.Value="Mix_Dial" />
                </StackPanel>
                <Button
                    x:Name="ChooseApps"
                    loc:Uid.Value="Mini_ChooseApps"
                    Classes="link"
                    IsVisible="False" />
            </c:HeadsetSection>

            <!--
                The settings changed mid-game, as quick tiles the way the
                system's quick settings are: a press turns one on or off, and a
                tile with more than one way of being on lists them from its
                corner. Spatial sound is the system's setting, not the headset's,
                but the panel is for the headset in use, so it folds away with
                the headset's settings rather than standing alone.
            -->
            <Panel x:Name="TilesArea">
                <c:HeadsetSection Explain="False" Spacing="{StaticResource NeapSpaceS}">
                    <UniformGrid x:Name="Tiles" ColumnSpacing="{StaticResource NeapSpaceS}" RowSpacing="{StaticResource NeapSpaceS}">
                        <c:MicTile x:Name="Mic" AsTile="True" />
                        <c:QuickTile x:Name="NoiseTile" />
                        <c:SpatialTile x:Name="Spatial" AsTile="True" />
                        <c:QuickTile x:Name="HearingTile" />
                    </UniformGrid>

                    <Border x:Name="PresetRow" Classes="quickrow">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource NeapSpaceS}">
                            <PathIcon
                                Classes="quickicon"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Data="{StaticResource IconEqualiser}" />
                            <TextBlock
                                Grid.Column="1"
                                loc:Uid.Value="Mini_Equaliser"
                                Classes="quicktitle"
                                VerticalAlignment="Center" />
                            <c:PresetChoice
                                x:Name="Preset"
                                Grid.Column="2"
                                MaxWidth="170"
                                loc:Uid.Value="Quick_PresetPicker" />
                        </Grid>
                    </Border>
                </c:HeadsetSection>
            </Panel>
        </StackPanel>
    </Border>
</Window>

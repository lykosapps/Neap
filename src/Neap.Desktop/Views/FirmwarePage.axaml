<UserControl
    x:Class="Neap.Desktop.Views.FirmwarePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <c:PageView>
        <StackPanel>

            <TextBlock loc:Uid.Value="Firmware_Title" Classes="pagetitle" />

            <!-- What an edit risks, said once at the top, so every action below is read with it. -->
            <TextBlock
                loc:Uid.Value="Firmware_Intro"
                MaxWidth="760"
                HorizontalAlignment="Left"
                Classes="secondary" />

            <c:HeadsetNotice />

            <!-- A headset this build cannot write is still shown: what fits it and what is on it. -->
            <c:Notice
                x:Name="CannotWrite"
                Margin="{StaticResource NeapSectionGap}"
                loc:Uid.Value="Firmware_CannotWrite"
                Severity="Warning" />

            <!--
                The edits as a list to tick, and one Apply: two edits can share a
                section of flash, so Neap works out what to write from the whole
                list and says it before anything is written.
            -->
            <TextBlock loc:Uid.Value="Firmware_EditsHeading" Classes="sectionheader" />
            <Border x:Name="EditsCard" Classes="card">
                <StackPanel Spacing="{StaticResource NeapSpaceM}">
                    <StackPanel x:Name="EditList" Spacing="{StaticResource NeapSpaceM}" />
                    <StackPanel Spacing="{StaticResource NeapSpaceXS}">
                        <TextBlock x:Name="PlanText" TextWrapping="Wrap" />
                        <TextBlock x:Name="BlockersText" Classes="caption secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                        <Button x:Name="ApplyButton" loc:Uid.Value="Firmware_Apply" Classes="accent" />
                        <Button x:Name="StockButton" loc:Uid.Value="Firmware_RestoreStock" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="NoEdits" loc:Uid.Value="Firmware_NoEdits" Classes="secondary" />

            <!--
                A run in progress, under the list it was started from. The one
                thing the person has to do is said largest, while it is theirs
                to do; the rest is the steps and how far the write has got.
            -->
            <Border
                x:Name="RunCard"
                Margin="0,8,0,0"
                Classes="card"
                IsVisible="False">
                <StackPanel Spacing="{StaticResource NeapSpaceM}">
                    <StackPanel Spacing="{StaticResource NeapSpaceHairline}">
                        <TextBlock x:Name="RunTitle" Classes="cardtitle" AutomationProperties.HeadingLevel="2" />
                        <TextBlock x:Name="RunSession" Classes="caption secondary" />
                    </StackPanel>
                    <TextBlock
                        x:Name="Guide"
                        Classes="bodystrong"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="Progress"
                        loc:Uid.Value="Firmware_Progress"
                        Maximum="100"
                        Minimum="0" />
                    <StackPanel x:Name="StepList" loc:Uid.Value="Firmware_Steps" Spacing="{StaticResource NeapSpaceXS}" />
                    <TextBlock
                        x:Name="OutcomeText"
                        Classes="bodystrong"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                        <Button x:Name="CancelButton" loc:Uid.Value="Firmware_StopWaiting" />
                        <Button x:Name="CloseButton" loc:Uid.Value="Firmware_CloseRun" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Every section written leaves its backup here. Putting one back is
                the way out for a headset an edit has left unwell.
            -->
            <TextBlock loc:Uid.Value="Firmware_BackupsHeading" Classes="sectionheader" />
            <TextBlock
                loc:Uid.Value="Firmware_BackupsNote"
                MaxWidth="760"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
                Classes="caption secondary" />
            <StackPanel x:Name="BackupList" Spacing="{StaticResource NeapSpaceXS}" />
            <TextBlock x:Name="NoBackups" loc:Uid.Value="Firmware_NoBackups" Classes="secondary" />

        </StackPanel>
    </c:PageView>
</UserControl>

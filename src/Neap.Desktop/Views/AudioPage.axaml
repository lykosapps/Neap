<UserControl
    x:Class="Neap.Desktop.Views.AudioPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <c:PageView>
        <StackPanel>

            <TextBlock loc:Uid.Value="Audio_Title" Classes="pagetitle" />

            <c:HeadsetNotice />

            <!--
                With the headset off, the whole page is one card: the
                system's volume goes on working without it, but on nothing
                the person can hear. See HeadsetSection.WhenOff.
            -->
            <c:HeadsetSection loc:Uid.Value="Audio_Section" WhenOff="True">
                <!--
                    Noise control with its three modes, and Superhuman Hearing as
                    Home's tile, side by side, with how strong each is under it
                    while it is on.
                -->
                <c:HeadsetSection loc:Uid.Value="Audio_HeadsetSection">
                    <TextBlock loc:Uid.Value="Audio_AroundYouHeading" Classes="sectionheader" />
                    <c:SideBySide>
                        <c:NoiseControlPanel />
                        <c:SettingTile
                            loc:Uid.Value="Audio_ShhTile"
                            Icon="{StaticResource IconHearing}"
                            Setting="superhuman_hearing">
                            <c:SettingTile.Inside>
                                <StackPanel>
                                <c:SettingRow
                                    loc:Uid.Value="Audio_Type"
                                    AsButtons="True"
                                    Setting="shh_preset" />
                                <c:SettingRow
                                    loc:Uid.Value="Audio_Intensity"
                                    Setting="shh_level" />
                                </StackPanel>
                            </c:SettingTile.Inside>
                        </c:SettingTile>
                    </c:SideBySide>
                </c:HeadsetSection>

                <!--
                    The system's own volume, with its mute beside it on one line,
                    and the headset's spoken alerts beside it, so every level is
                    in one place and neither row is a wide card with a short
                    slider.
                -->
                <TextBlock loc:Uid.Value="Audio_VolumeHeading" Classes="sectionheader" />
                <c:RoutingNotice Microphone="False" />
                <c:SideBySide Margin="{StaticResource NeapSectionGap}">
                    <c:SystemVolumeRow
                        loc:Uid.Value="Audio_MasterVolume"
                        Icon="{StaticResource IconVolume}"
                        WithMute="True" />
                    <c:HeadsetSection Explain="False">
                        <c:SettingRow
                            loc:Uid.Value="Audio_VoicePrompts"
                            Icon="{StaticResource IconPrompt}"
                            Setting="voice_prompt_volume" />
                    </c:HeadsetSection>
                </c:SideBySide>

                <!--
                    A headset-side level that makes everything louder, for the
                    "too quiet at maximum" complaint. It hides itself on a
                    headset that does not answer for it; see LoudnessBoostRow.
                -->
                <c:LoudnessBoostRow
                    loc:Uid.Value="Audio_LoudnessBoost"
                    Margin="{StaticResource NeapSectionGap}"
                    Icon="{StaticResource IconVolume}" />
                <c:SpatialTile Margin="{StaticResource NeapSectionGap}" AsRow="True" />
            </c:HeadsetSection>

            <!--
                With the headset off, the whole section is one card, the level
                included: see HeadsetSection.WhenOff.
            -->
            <c:HeadsetSection loc:Uid.Value="Microphone_Section" WhenOff="True">
                <c:RoutingNotice Sound="False" />

                <!--
                    What they hear, first: the microphone's tile, as on Home, beside a
                    wide live meter of what it picks up. The meter listens only while
                    this page is open, since the system shows its microphone in use
                    light for as long as it does.
                -->
                <Grid Margin="{StaticResource NeapSectionGap}" ColumnDefinitions="240,*" ColumnSpacing="{StaticResource NeapSpaceS}">
                    <c:HeadsetSection Explain="False">
                        <c:MicTile />
                    </c:HeadsetSection>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="{StaticResource NeapSpaceS}">
                            <TextBlock loc:Uid.Value="Microphone_LevelLabel" Classes="label" />
                            <c:MicMeter loc:Uid.Value="Microphone_Meter" Large="True" />
                            <TextBlock loc:Uid.Value="Microphone_LevelNote" Classes="caption secondary" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The two levels side by side, as on Audio. -->
                <TextBlock loc:Uid.Value="Microphone_VoiceHeading" Classes="sectionheader" />
                <c:SideBySide>
                    <c:SystemVolumeRow
                        loc:Uid.Value="Microphone_Sensitivity"
                        Capture="True"
                        Icon="{StaticResource IconMicrophone}" />
                    <c:HeadsetSection Explain="False">
                        <c:SettingRow
                            loc:Uid.Value="Microphone_MicMonitoring"
                            Icon="{StaticResource IconHearing}"
                            Setting="mic_monitoring" />
                    </c:HeadsetSection>
                </c:SideBySide>

                <c:HeadsetSection loc:Uid.Value="Microphone_HeadsetSection">
                    <!--
                        Noise reduction and the gate as tiles, like Audio's, with the
                        gate's threshold under it while the gate is on: it means nothing
                        while the gate is off.
                    -->
                    <TextBlock loc:Uid.Value="Microphone_NoiseHandlingHeading" Classes="sectionheader" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource NeapSpaceS}">
                        <c:SettingTile
                            loc:Uid.Value="Microphone_AiTile"
                            Icon="{StaticResource IconNoise}"
                            Setting="ai_noise_reduction" />
                        <c:SettingTile
                            loc:Uid.Value="Microphone_GateTile"
                            Grid.Column="1"
                            Icon="{StaticResource IconGate}"
                            Setting="noise_gate">
                            <c:SettingTile.Inside>
                                <c:SettingRow
                                    loc:Uid.Value="Microphone_Threshold"
                                    Setting="noise_gate_threshold" />
                            </c:SettingTile.Inside>
                        </c:SettingTile>
                    </Grid>
                </c:HeadsetSection>
            </c:HeadsetSection>

        </StackPanel>
    </c:PageView>
</UserControl>

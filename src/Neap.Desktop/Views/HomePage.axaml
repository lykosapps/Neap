<UserControl
    x:Class="Neap.Desktop.Views.HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <StackPanel
                Classes="pagecolumn"
                Spacing="16">

                <!-- Nothing plugged in is said first, in words. -->
                <c:HeadsetNotice />

                <c:QuickControls />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

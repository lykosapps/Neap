<UserControl
    x:Class="Neap.Desktop.Views.HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls">

    <c:PageView>
        <StackPanel Spacing="{StaticResource NeapSpaceS}">

            <!-- Nothing plugged in is said first, in words. -->
            <c:HeadsetNotice />

            <c:QuickControls />

        </StackPanel>
    </c:PageView>
</UserControl>

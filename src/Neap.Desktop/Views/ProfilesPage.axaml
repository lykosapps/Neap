<UserControl
    x:Class="Neap.Desktop.Views.ProfilesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <c:PageView>
        <StackPanel Spacing="{StaticResource NeapSpaceL}">

            <!--
                Saving the headset's settings as a profile is the same
                action as New profile in the header's menu, which stays
                where it is for the quick case. The notice says why the
                button is off while the headset is not answering.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    loc:Uid.Value="Profiles_Title"
                    Margin="0"
                    VerticalAlignment="Center"
                    Classes="pagetitle" />
                <Button
                    x:Name="New"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="accent" />
            </Grid>

            <StackPanel Spacing="{StaticResource NeapSpaceS}">
                <TextBlock
                    loc:Uid.Value="Profiles_Note"
                    Margin="0"
                    Classes="sectionnote" />
                <TextBlock x:Name="Notice" Classes="caption secondary" />
            </StackPanel>

            <c:ProfilesSettings />

        </StackPanel>
    </c:PageView>
</UserControl>

<UserControl
    x:Class="Neap.Desktop.Views.EqualiserPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <c:PageView>
        <StackPanel>

            <TextBlock loc:Uid.Value="EqualiserPage_Title" Classes="pagetitle" />

            <c:HeadsetNotice />

            <c:HeadsetSection loc:Uid.Value="EqualiserPage_Section">
                <!-- One equaliser at a time: the game's or the microphone's. -->
                <Border Classes="segmented" loc:Uid.Value="EqualiserPage_Bank">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="GameTab"
                            loc:Uid.Value="EqualiserPage_Game"
                            GroupName="EqBank"
                            IsChecked="True"
                            Theme="{StaticResource SegmentButton}" />
                        <RadioButton
                            x:Name="MicTab"
                            loc:Uid.Value="EqualiserPage_Mic"
                            GroupName="EqBank"
                            Theme="{StaticResource SegmentButton}" />
                    </StackPanel>
                </Border>

                <c:EqualiserPanel x:Name="GamePanel" Bank="Game" Margin="{StaticResource NeapSectionGap}" />
                <c:EqualiserPanel x:Name="MicPanel" Bank="Mic" IsVisible="False" Margin="{StaticResource NeapSectionGap}" />
            </c:HeadsetSection>

        </StackPanel>
    </c:PageView>
</UserControl>

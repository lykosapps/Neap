<UserControl
    x:Class="Neap.Desktop.Controls.SpatialTile"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <!--
        The system's spatial sound for the headset, as a card on Home or a row
        on Audio. The card is a choice among the formats the system offers, so
        it is a segmented control under the title, the same as noise
        cancellation. A line under it says what to know about the format, such
        as Dolby Atmos needing its driver.
    -->
    <Grid>
        <Border
            x:Name="Card"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconSpatial}" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_Spatial"
                    Classes="tiletitle" />
                <Border
                    x:Name="Choice"
                    Margin="{StaticResource NeapSectionGap}"
                    Classes="segmented"
                    IsEnabled="False" />
                <TextBlock
                    x:Name="Note"
                    Margin="{StaticResource NeapSectionGap}"
                    Classes="caption secondary"
                    IsVisible="False" />
            </StackPanel>
        </Border>

        <c:SettingsCard
            x:Name="Row"
            loc:Uid.Value="Spatial_Row"
            Icon="{StaticResource IconSpatial}"
            IsVisible="False" />

        <c:QuickTile x:Name="Tile" IsVisible="False" />
    </Grid>
</UserControl>

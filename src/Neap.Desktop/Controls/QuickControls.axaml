<UserControl
    x:Class="Neap.Desktop.Controls.QuickControls"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls">

    <StackPanel Spacing="{StaticResource NeapSpaceS}">

        <!--
            The headset, how it is connected, and the two readings worth a
            glance. The title row says the state on every page; this says
            which transmitter and how much battery is left.
        -->
        <Border Classes="card">
            <Grid
                x:Name="Header"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="{StaticResource NeapSpaceXL}"
                RowDefinitions="Auto,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource NeapSpaceXS}">
                    <TextBlock x:Name="HeadsetName" Classes="cardtitle" AutomationProperties.HeadingLevel="1" />
                    <!-- A grid, not a row of two: the words wrap beside the dot in a narrow window instead of running under the readings. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource NeapSpaceS}">
                        <Ellipse
                            x:Name="StateDot"
                            Width="{StaticResource NeapStatusDot}"
                            Height="{StaticResource NeapStatusDot}"
                            Margin="{StaticResource NeapStatusDotLine}"
                            VerticalAlignment="Top"
                            Classes="caution" />
                        <TextBlock
                            x:Name="HowConnected"
                            Grid.Column="1"
                            Classes="secondary"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <StackPanel
                    x:Name="Readings"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource NeapSpaceXL}" />
            </Grid>
        </Border>

        <!-- The system playing somewhere the headset is not listening. -->
        <c:RoutingNotice />

        <!--
            One note for every state that needs explaining, filled from
            StateCopy: what is happening, what still moves the mix, the one
            thing to do, and a fallback last. The mix leaves the chat wheel to
            this note, so the problem is said once. It sits where the controls
            it replaces were, so nothing moves under the pointer.
        -->
        <Border x:Name="NotePanel" Classes="card" IsVisible="False">
            <StackPanel Spacing="{StaticResource NeapSpaceS}">
                <TextBlock x:Name="NoteWhat" Classes="bodystrong" />
                <TextBlock x:Name="NoteMix" Classes="secondary" />
                <TextBlock x:Name="NoteFix" />
                <TextBlock x:Name="NoteFallback" Classes="caption secondary" />
            </StackPanel>
        </Border>

        <!--
            The mix, then the settings as tiles straight on the page. The mix
            goes on working with only the headset's settings out of reach, so
            it folds only when the headset is away. The tiles fold whenever
            they cannot be reached.
        -->
        <Border x:Name="MixCard" Classes="card">
            <c:MixPanel ExplainsWheel="False" />
        </Border>
        <c:QuickSettings x:Name="SettingsCard" />

    </StackPanel>
</UserControl>

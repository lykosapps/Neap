<UserControl
    x:Class="Neap.Desktop.Controls.ParametricPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <StackPanel Spacing="12">

        <!--
            The test tone: moved by hand or swept, heard through the
            equaliser, with a cut or boost added where it stands.
        -->
        <Border
            Padding="12"
            BorderBrush="{DynamicResource NeapPanelStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <!--
                    One row when there is room, with Cut here and Boost here
                    beside the tone's other controls; under them when there
                    is not. See Arrange.
                -->
                <Grid
                    x:Name="ToneRow"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,100"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8">
                    <TextBlock
                        loc:Uid.Value="Tone_Label"
                        VerticalAlignment="Center"
                        Classes="secondary" />
                    <Button
                        x:Name="SweepButton"
                        Grid.Column="1"
                        MinWidth="96">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon x:Name="SweepIcon" Width="16" Height="16" />
                            <TextBlock x:Name="SweepText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StopButton"
                        loc:Uid.Value="Tone_Stop"
                        Grid.Column="2"
                        VerticalAlignment="Stretch">
                        <PathIcon Width="16" Height="16" Data="{StaticResource IconStop}" />
                    </Button>
                    <StackPanel
                        x:Name="Marks"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="CutButton" loc:Uid.Value="Tone_Cut">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconArrowDown}" />
                                <TextBlock loc:Uid.Value="Tone_CutLabel" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BoostButton" loc:Uid.Value="Tone_Boost">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16" Data="{StaticResource IconArrowUp}" />
                                <TextBlock loc:Uid.Value="Tone_BoostLabel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <PathIcon
                        Grid.Column="5"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource NeapTextSecondaryBrush}"
                        Data="{StaticResource IconAudio}" />
                    <Slider
                        x:Name="LevelSlider"
                        loc:Uid.Value="Tone_Level"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0" />
                </Grid>
                <!--
                    The tone's frequency across the panel's whole width, so a
                    pixel moves it a small step. An arrow key moves it about
                    1 %, Page Up and Page Down half an octave.
                -->
                <Grid ColumnDefinitions="*,80" ColumnSpacing="8">
                    <Slider
                        x:Name="ToneSlider"
                        loc:Uid.Value="Tone_Frequency"
                        VerticalAlignment="Center"
                        LargeChange="100"
                        Maximum="2000"
                        Minimum="0"
                        SmallChange="3" />
                    <TextBlock
                        x:Name="ToneText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="numeralstrong" />
                </Grid>
                <TextBlock
                    x:Name="ToneTrouble"
                    Classes="secondary"
                    IsVisible="False" />
                <TextBlock loc:Uid.Value="Tone_HowTo" Classes="caption secondary" />
            </StackPanel>
        </Border>

        <!-- The key to the two curves: which is asked for and which is heard. -->
        <StackPanel Orientation="Horizontal" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Line
                    VerticalAlignment="Center"
                    EndPoint="22,0"
                    Stroke="{DynamicResource NeapTextSecondaryBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1.5" />
                <TextBlock loc:Uid.Value="Parametric_Asked" Classes="caption secondary" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Line
                    VerticalAlignment="Center"
                    EndPoint="22,0"
                    Stroke="{DynamicResource NeapGameBrush}"
                    StrokeThickness="2" />
                <TextBlock loc:Uid.Value="Parametric_Heard" Classes="caption secondary" />
            </StackPanel>
        </StackPanel>

        <c:ParametricCurve x:Name="Shape" Height="200" />

        <!-- Only when the headset misses by enough to hear. -->
        <StackPanel
            x:Name="Miss"
            Orientation="Horizontal"
            Spacing="8"
            IsVisible="False">
            <PathIcon
                Width="16"
                Height="16"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                Foreground="{DynamicResource NeapToneCautionBrush}"
                Data="{StaticResource IconWarning}" />
            <TextBlock loc:Uid.Value="Parametric_Miss" Classes="secondary" />
        </StackPanel>

        <!-- One button per adjustment, then adding and removing. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel
                x:Name="Chips"
                Orientation="Horizontal"
                Spacing="8" />
            <Button x:Name="AddButton" loc:Uid.Value="Parametric_Add">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="16" Height="16" Data="{StaticResource IconAdd}" />
                    <TextBlock loc:Uid.Value="Parametric_AddLabel" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveButton" VerticalAlignment="Stretch">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconDelete}" />
            </Button>
        </StackPanel>

        <TextBlock
            x:Name="Empty"
            loc:Uid.Value="Parametric_Empty"
            Classes="secondary" />

        <!-- The chosen adjustment, for the keyboard and for exact values. -->
        <Grid
            x:Name="Fields"
            ColumnDefinitions="88,*,112"
            ColumnSpacing="12"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">

            <TextBlock
                loc:Uid.Value="Parametric_Frequency"
                VerticalAlignment="Center"
                Classes="secondary" />
            <Slider
                x:Name="FrequencySlider"
                loc:Uid.Value="Parametric_FrequencySlider"
                Grid.Column="1"
                LargeChange="50"
                Maximum="1000"
                Minimum="0"
                SmallChange="10" />
            <c:FrequencyBox
                x:Name="FrequencyField"
                loc:Uid.Value="Parametric_FrequencyField"
                Grid.Column="2"
                VerticalAlignment="Center" />

            <TextBlock
                loc:Uid.Value="Parametric_Gain"
                Grid.Row="1"
                VerticalAlignment="Center"
                Classes="secondary" />
            <Slider
                x:Name="GainSlider"
                loc:Uid.Value="Parametric_GainSlider"
                Grid.Row="1"
                Grid.Column="1"
                IsSnapToTickEnabled="True"
                LargeChange="1"
                Maximum="9"
                Minimum="-9"
                SmallChange="0.5"
                TickFrequency="0.5" />
            <TextBlock
                x:Name="GainText"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="numeralstrong" />

            <TextBlock
                loc:Uid.Value="Parametric_Width"
                Grid.Row="2"
                Margin="0,6,0,0"
                VerticalAlignment="Top"
                Classes="secondary" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <Slider
                    x:Name="WidthSlider"
                    loc:Uid.Value="Parametric_WidthSlider"
                    IsSnapToTickEnabled="True"
                    LargeChange="0.5"
                    Maximum="3"
                    Minimum="1"
                    SmallChange="0.1"
                    TickFrequency="0.1" />
                <!-- The narrow end is the headset's limit, and says so. -->
                <Grid>
                    <TextBlock loc:Uid.Value="Parametric_Narrowest" Classes="caption secondary" />
                    <TextBlock
                        loc:Uid.Value="Parametric_Wide"
                        HorizontalAlignment="Right"
                        Classes="caption secondary" />
                </Grid>
            </StackPanel>
            <TextBlock
                x:Name="WidthText"
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,6,0,0"
                VerticalAlignment="Top"
                Classes="numeralstrong" />
        </Grid>

        <!--
            What reaches the headset: the ten gains, nothing else. Folded,
            since the solid line already draws them; open for the numbers.
        -->
        <Expander
            loc:Uid.Value="Parametric_SentExpander"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Grid x:Name="Sent" />
        </Expander>
    </StackPanel>
</UserControl>

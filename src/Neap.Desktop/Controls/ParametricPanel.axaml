<UserControl
    x:Class="Neap.Desktop.Controls.ParametricPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <StackPanel Spacing="{StaticResource NeapSpaceM}">

        <!-- The key to the two curves: which is asked for and which is heard. -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceL}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                <Line
                    VerticalAlignment="Center"
                    EndPoint="22,0"
                    Stroke="{DynamicResource NeapTextSecondaryBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1.5" />
                <TextBlock loc:Uid.Value="Parametric_Asked" Classes="caption secondary" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                <Line
                    VerticalAlignment="Center"
                    EndPoint="22,0"
                    Stroke="{DynamicResource NeapGameBrush}"
                    StrokeThickness="2" />
                <TextBlock loc:Uid.Value="Parametric_Heard" Classes="caption secondary" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                <Border
                    Width="22"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{DynamicResource NeapCurveGapBrush}" />
                <TextBlock loc:Uid.Value="Parametric_Gap" Classes="caption secondary" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <c:ParametricCurve x:Name="Shape" Height="280" />
            <Border
                x:Name="FlatCaption"
                Classes="comparecaption"
                IsHitTestVisible="False"
                IsVisible="False">
                <TextBlock loc:Uid.Value="Equaliser_Flat" />
            </Border>
        </Grid>

        <!-- Only when the headset misses by enough to hear. -->
        <StackPanel
            x:Name="Miss"
            Orientation="Horizontal"
            Spacing="{StaticResource NeapSpaceS}"
            IsVisible="False">
            <PathIcon
                Width="{StaticResource NeapIconRow}"
                Height="{StaticResource NeapIconRow}"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                Foreground="{DynamicResource NeapToneCautionBrush}"
                Data="{StaticResource IconWarning}" />
            <TextBlock loc:Uid.Value="Parametric_Miss" Classes="secondary" />
        </StackPanel>

        <!-- One button per adjustment, then adding and removing. -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
            <StackPanel
                x:Name="Chips"
                Orientation="Horizontal"
                Spacing="{StaticResource NeapSpaceS}" />
            <Button x:Name="AddButton" loc:Uid.Value="Parametric_Add">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                    <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconAdd}" />
                    <TextBlock loc:Uid.Value="Parametric_AddLabel" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveButton" VerticalAlignment="Stretch">
                <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconDelete}" />
            </Button>
        </StackPanel>

        <TextBlock
            x:Name="Empty"
            loc:Uid.Value="Parametric_Empty"
            Classes="secondary" />

        <!-- The chosen adjustment, for the keyboard and for exact values. -->
        <Grid
            x:Name="Fields"
            ColumnDefinitions="88,*,112"
            ColumnSpacing="{StaticResource NeapSpaceM}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="{StaticResource NeapSpaceS}">

            <TextBlock
                loc:Uid.Value="Parametric_Frequency"
                VerticalAlignment="Center"
                Classes="secondary" />
            <Slider
                x:Name="FrequencySlider"
                loc:Uid.Value="Parametric_FrequencySlider"
                Grid.Column="1"
                LargeChange="50"
                Maximum="1000"
                Minimum="0"
                SmallChange="10" />
            <c:FrequencyBox
                x:Name="FrequencyField"
                loc:Uid.Value="Parametric_FrequencyField"
                Grid.Column="2"
                VerticalAlignment="Center" />

            <TextBlock
                loc:Uid.Value="Parametric_Gain"
                Grid.Row="1"
                VerticalAlignment="Center"
                Classes="secondary" />
            <Slider
                x:Name="GainSlider"
                loc:Uid.Value="Parametric_GainSlider"
                Grid.Row="1"
                Grid.Column="1"
                IsSnapToTickEnabled="True"
                LargeChange="1"
                Maximum="9"
                Minimum="-9"
                SmallChange="0.5"
                TickFrequency="0.5" />
            <TextBlock
                x:Name="GainText"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="numeralstrong" />

            <TextBlock
                loc:Uid.Value="Parametric_Width"
                Grid.Row="2"
                Margin="0,6,0,0"
                VerticalAlignment="Top"
                Classes="secondary" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <Slider
                    x:Name="WidthSlider"
                    loc:Uid.Value="Parametric_WidthSlider"
                    IsSnapToTickEnabled="True"
                    LargeChange="0.5"
                    Maximum="3"
                    Minimum="1"
                    SmallChange="0.1"
                    TickFrequency="0.1" />
                <!-- The narrow end is the headset limit, and says so. -->
                <Grid>
                    <TextBlock loc:Uid.Value="Parametric_Narrowest" Classes="caption secondary" />
                    <TextBlock
                        loc:Uid.Value="Parametric_Wide"
                        HorizontalAlignment="Right"
                        Classes="caption secondary" />
                </Grid>
            </StackPanel>
            <TextBlock
                x:Name="WidthText"
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,6,0,0"
                VerticalAlignment="Top"
                Classes="numeralstrong" />
        </Grid>

        <!--
            The test tone, folded until it is wanted: moved by hand or swept,
            heard through the equaliser, with a cut or boost added where it
            stands. Folding it stops it, since a tone playing behind a
            closed row is one nobody can stop.
        -->
        <Expander
            x:Name="ToneExpander"
            loc:Uid.Value="Tone_Title"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="{StaticResource NeapSpaceS}">
                <!--
                    One row when there is room, with Cut here and Boost here
                    beside the tone's other controls; under them when there
                    is not. See Arrange.
                -->
                <Grid
                    x:Name="ToneRow"
                    ColumnDefinitions="Auto,Auto,Auto,*,Auto,100"
                    ColumnSpacing="{StaticResource NeapSpaceS}"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{StaticResource NeapSpaceS}">
                    <Button
                        x:Name="SweepButton"
                        MinWidth="96">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                            <PathIcon x:Name="SweepIcon" Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" />
                            <TextBlock x:Name="SweepText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StopButton"
                        loc:Uid.Value="Tone_Stop"
                        Grid.Column="1"
                        VerticalAlignment="Stretch">
                        <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconStop}" />
                    </Button>
                    <StackPanel
                        x:Name="Marks"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="{StaticResource NeapSpaceS}">
                        <Button x:Name="CutButton" loc:Uid.Value="Tone_Cut">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                                <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconArrowDown}" />
                                <TextBlock loc:Uid.Value="Tone_CutLabel" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BoostButton" loc:Uid.Value="Tone_Boost">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                                <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconArrowUp}" />
                                <TextBlock loc:Uid.Value="Tone_BoostLabel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <PathIcon
                        Grid.Column="4"
                        Width="{StaticResource NeapIconRow}"
                        Height="{StaticResource NeapIconRow}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource NeapTextSecondaryBrush}"
                        Data="{StaticResource IconVolume}" />
                    <Slider
                        x:Name="LevelSlider"
                        loc:Uid.Value="Tone_Level"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0" />
                </Grid>
                <!--
                    The tone frequency across the whole width, so a pixel
                    moves it a small step. An arrow key moves it about 1 %,
                    Page Up and Page Down half an octave.
                -->
                <Grid ColumnDefinitions="*,80" ColumnSpacing="{StaticResource NeapSpaceS}">
                    <Slider
                        x:Name="ToneSlider"
                        loc:Uid.Value="Tone_Frequency"
                        VerticalAlignment="Center"
                        LargeChange="100"
                        Maximum="2000"
                        Minimum="0"
                        SmallChange="3" />
                    <TextBlock
                        x:Name="ToneText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="numeralstrong" />
                </Grid>
                <TextBlock
                    x:Name="ToneTrouble"
                    Classes="secondary"
                    IsVisible="False" />
                <TextBlock loc:Uid.Value="Tone_HowTo" Classes="caption secondary" />
            </StackPanel>
        </Expander>

        <!--
            What reaches the headset: the ten gains, nothing else. Folded,
            since the solid line already draws them; open for the numbers.
        -->
        <Expander
            loc:Uid.Value="Parametric_SentExpander"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Grid x:Name="Sent" />
        </Expander>
    </StackPanel>
</UserControl>
<UserControl
    x:Class="Neap.Desktop.Controls.MixPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <!--
        The dial on the left and the card's own column beside it: its name,
        each side's level and meter, and the chat apps. Arrange stacks them in
        a narrow card.
    -->
    <Grid x:Name="Layout" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

        <!--
            The knob, drawn smaller than its own size so the card is as tall as
            the column beside it, with the way the mix leans on its cap.
            Disabled until chat apps are chosen, so the card shows what it is
            for before the question beside it is answered.
        -->
        <Viewbox
            x:Name="DialArea"
            Width="{StaticResource NeapDialShown}"
            Height="{StaticResource NeapDialShown}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="mixdial">
            <Grid>
                <c:GameChatDial x:Name="Dial" loc:Uid.Value="Mix_Dial" />
                <TextBlock
                    x:Name="LeanText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False" />
            </Grid>
        </Viewbox>

        <StackPanel
            x:Name="Side"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="{StaticResource NeapSpaceM}">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource NeapSpaceM}">
                <TextBlock
                    loc:Uid.Value="Mix_Title"
                    VerticalAlignment="Center"
                    Classes="cardtitle"
                    AutomationProperties.HeadingLevel="2" />
                <!--
                    The keys move the mix as the chat wheel does, and are a headset's only
                    way to do it without one, so the card's header links to where they are set.
                -->
                <Button
                    x:Name="KeysLink"
                    loc:Uid.Value="Mix_KeysLink"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Classes="link" />
            </Grid>

            <!--
                The chat wheel cannot reach the app, with what still moves the
                mix. Inside the mix, not in a note elsewhere, so wherever the mix
                is shown the reason comes with it.
            -->
            <c:Notice x:Name="WheelBar" loc:Uid.Value="Mix_WheelBar" />

            <!--
                The chat application is playing somewhere the mix cannot reach.
                Without this the wheel stops affecting chat and nothing says
                why.
            -->
            <c:Notice x:Name="ElsewhereBar" loc:Uid.Value="Mix_ElsewhereBar" Severity="Warning" />

            <!--
                Nothing chosen yet, the question the disabled dial is waiting
                on; once an app is chosen, the levels in its place. The two
                share one cell, so the card keeps its height and the field
                below never moves under the pointer as the first app is ticked.
            -->
            <Grid>
                <TextBlock
                    x:Name="SetupLine"
                    loc:Uid.Value="Mix_Setup"
                    VerticalAlignment="Center"
                    Classes="secondary"
                    IsVisible="False" />

                <!--
                    Each side's name, what it is playing just now and how loud the
                    mix lets it play. The number is the setting; the bars are the
                    sound, decoration that a screen reader skips.
                -->
                <Grid
                    x:Name="Levels"
                    ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource NeapSpaceM}"
                    RowSpacing="{StaticResource NeapSpaceS}">
                    <TextBlock loc:Uid.Value="Mix_Game" Foreground="{DynamicResource NeapGameTextBrush}" />
                    <c:LevelBars x:Name="GameBars" Grid.Column="1" Count="{StaticResource NeapMixBars}" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="GameLevel"
                        Grid.Column="2"
                        MinWidth="32"
                        FontFeatures="tnum"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource NeapGameTextBrush}"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="1" loc:Uid.Value="Mix_Chat" Foreground="{DynamicResource NeapChatTextBrush}" />
                    <c:LevelBars x:Name="ChatBars" Grid.Row="1" Grid.Column="1" Count="{StaticResource NeapMixBars}" VerticalAlignment="Center" Classes="chat" />
                    <TextBlock
                        x:Name="ChatLevel"
                        Grid.Row="1"
                        Grid.Column="2"
                        MinWidth="32"
                        FontFeatures="tnum"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource NeapChatTextBrush}"
                        TextAlignment="Right" />
                </Grid>
            </Grid>

            <!--
                Which applications carry chat: the only thing the mix needs to
                know. A field naming the chosen apps; the list opens in a flyout
                over the page, so choosing never changes the card's height.
            -->
            <Button x:Name="ChatFromButton" Classes="chooser">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource NeapSpaceS}">
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource NeapSpaceHairline}">
                        <TextBlock loc:Uid.Value="Mix_ChatFrom" Classes="caption secondary" />
                        <TextBlock x:Name="ChosenText" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <PathIcon
                        Grid.Column="1"
                        Width="{StaticResource NeapIconRow}"
                        Height="{StaticResource NeapIconRow}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource NeapTextSecondaryBrush}"
                        Data="{StaticResource IconChevronDown}" />
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel MinWidth="260" MaxWidth="360" Spacing="{StaticResource NeapSpaceS}">
                            <StackPanel x:Name="AppList" Spacing="{StaticResource NeapSpaceXS}" />
                            <!--
                                Only applications with sound open on the headset are
                                listed, so one not yet started is missing. The notice
                                below says so instead when nothing is listed at all.
                            -->
                            <TextBlock
                                x:Name="MissingHint"
                                loc:Uid.Value="Mix_MissingHint"
                                Classes="caption secondary" />
                            <c:Notice x:Name="Nothing" loc:Uid.Value="Mix_NothingPlaying" />
                            <Button x:Name="Refresh" loc:Uid.Value="Mix_Refresh" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                                    <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconRefresh}" />
                                    <TextBlock loc:Uid.Value="Mix_RefreshText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

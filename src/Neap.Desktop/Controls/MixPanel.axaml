<UserControl
    x:Class="Neap.Desktop.Controls.MixPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <!--
        The dial on the left and the card's own column beside it: its name, the
        chat apps and the way to the keys. Arrange stacks them in a narrow card.
    -->
    <Grid x:Name="Layout" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

        <!--
            The knob, with how loud each side plays on its cap. Disabled until
            chat apps are chosen, so the card shows what it is for before the
            question below is answered.
        -->
        <Grid
            x:Name="DialArea"
            Margin="0,0,0,14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="mixdial">
            <c:GameChatDial x:Name="Dial" loc:Uid.Value="Mix_Dial" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="{StaticResource NeapSpaceHairline}">
                <TextBlock
                    x:Name="LeanText"
                    HorizontalAlignment="Center"
                    Classes="label" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource NeapSpaceM}">
                    <TextBlock
                        x:Name="GameLevel"
                        MinWidth="56"
                        Classes="reading"
                        Foreground="{DynamicResource NeapGameTextBrush}"
                        TextAlignment="Right" />
                    <TextBlock
                        x:Name="ChatLevel"
                        MinWidth="56"
                        Classes="reading"
                        Foreground="{DynamicResource NeapChatTextBrush}"
                        TextAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- Under each end of the ring: which side is which. -->
            <TextBlock
                loc:Uid.Value="Mix_Game"
                Margin="28,0,0,-14"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Classes="label"
                Foreground="{DynamicResource NeapGameTextBrush}" />
            <TextBlock
                loc:Uid.Value="Mix_Chat"
                Margin="0,0,28,-14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Classes="label"
                Foreground="{DynamicResource NeapChatTextBrush}" />
        </Grid>

        <StackPanel
            x:Name="Side"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="{StaticResource NeapSpaceM}">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource NeapSpaceM}">
                <TextBlock
                    loc:Uid.Value="Mix_Title"
                    VerticalAlignment="Center"
                    Classes="cardtitle"
                    AutomationProperties.HeadingLevel="2" />
                <!--
                    The keys move the mix as the chat wheel does, and are a headset's only
                    way to do it without one, so the card's header links to where they are set.
                -->
                <Button
                    x:Name="KeysLink"
                    loc:Uid.Value="Mix_KeysLink"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Classes="link" />
            </Grid>

            <!--
                The chat wheel cannot reach the app, with what still moves the
                mix. Inside the mix, not in a note elsewhere, so wherever the mix
                is shown the reason comes with it.
            -->
            <c:Notice x:Name="WheelBar" loc:Uid.Value="Mix_WheelBar" />

            <!--
                The chat application is playing somewhere the mix cannot reach.
                Without this the wheel stops affecting chat and nothing says
                why.
            -->
            <c:Notice x:Name="ElsewhereBar" loc:Uid.Value="Mix_ElsewhereBar" Severity="Warning" />

            <!--
                Nothing chosen yet: the question the disabled dial is waiting on.
            -->
            <TextBlock
                x:Name="SetupLine"
                loc:Uid.Value="Mix_Setup"
                Classes="secondary"
                IsVisible="False" />

            <!--
                Which applications carry chat: the only thing the mix needs to
                know. Folded to a line naming them once chosen, and open until
                then, because the choice is the question the panel is asking.
            -->
            <Border Classes="inset">
                <Expander
                    x:Name="ChatFrom"
                    CornerRadius="{StaticResource NeapRadiusInset}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Resources>
                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
                    </Expander.Resources>
                    <Expander.Header>
                        <StackPanel Margin="0,8" Spacing="{StaticResource NeapSpaceHairline}">
                            <TextBlock loc:Uid.Value="Mix_ChatFrom" Classes="caption secondary" />
                            <TextBlock x:Name="ChosenText" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="{StaticResource NeapSpaceS}">
                        <StackPanel x:Name="AppList" Spacing="{StaticResource NeapSpaceXS}" />
                        <!--
                            Only applications with sound open on the headset are
                            listed, so one not yet started is missing. The notice
                            below says so instead when nothing is listed at all.
                        -->
                        <TextBlock
                            x:Name="MissingHint"
                            loc:Uid.Value="Mix_MissingHint"
                            Classes="caption secondary" />
                        <c:Notice x:Name="Nothing" loc:Uid.Value="Mix_NothingPlaying" />
                        <Button x:Name="Refresh" loc:Uid.Value="Mix_Refresh">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                                <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconRefresh}" />
                                <TextBlock loc:Uid.Value="Mix_RefreshText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

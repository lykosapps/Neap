<UserControl
    x:Class="Neap.Desktop.Controls.HeadsetStatusStrip"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A dot and a word, and nothing else. Link, route, Bluetooth, signal
        and battery belong on Home: in a strip this size each added fact
        makes the others harder to read. The title row says only whether to
        go and look.
    -->
    <StackPanel x:Name="ConnectionGroup" Classes="gaprow">
        <Ellipse
            x:Name="ConnectionDot"
            VerticalAlignment="Center"
            Classes="statusdot caution" />
        <TextBlock x:Name="ConnectionText" Classes="caption" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>

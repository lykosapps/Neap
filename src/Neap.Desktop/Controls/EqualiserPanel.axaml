<UserControl
    x:Class="Neap.Desktop.Controls.EqualiserPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <StackPanel>

        <!--
            The presets beside the editor, or above it when the window is too
            narrow for both; see Arrange.
        -->
        <Grid
            x:Name="Layout"
            ColumnDefinitions="200,*"
            ColumnSpacing="{StaticResource NeapSpaceS}"
            RowDefinitions="Auto,Auto"
            RowSpacing="{StaticResource NeapSpaceS}">

            <!--
                The slots, factory then yours, and how many are left: that is
                part of the decision to save. Choosing one applies it.
            -->
            <Border x:Name="PresetsCard" Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="{StaticResource NeapSpaceHairline}">
                    <TextBlock
                        loc:Uid.Value="Equaliser_PresetsLabel"
                        Margin="{StaticResource NeapIndent}"
                        Classes="label" />
                    <!-- One group for a screen reader, named for the bank it holds. -->
                    <StackPanel x:Name="Presets" Spacing="{StaticResource NeapSpaceHairline}">
                        <StackPanel x:Name="FactorySlots" Margin="{StaticResource NeapSectionGap}" Spacing="{StaticResource NeapSpaceHairline}" />
                        <Border
                            Height="1"
                            Margin="0,6"
                            Background="{DynamicResource NeapRuleBrush}" />
                        <StackPanel x:Name="CustomSlots" Spacing="{StaticResource NeapSpaceHairline}" />

                        <!--
                            Stands for the curve being edited when it is no
                            preset at all: a new one, or one the headset does
                            not know.
                        -->
                        <Border x:Name="Draft" Classes="draft">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource NeapSpaceS}">
                                <Border Classes="marker" Opacity="1" />
                                <TextBlock
                                    x:Name="PresetName"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <Border x:Name="DraftPill" Grid.Column="2" Classes="edited">
                                    <TextBlock loc:Uid.Value="Equaliser_Edited" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--
                        A new preset from flat, without choosing and changing
                        one first. Unavailable with every slot full, as the
                        note under it says.
                    -->
                    <Button
                        x:Name="NewButton"
                        loc:Uid.Value="Equaliser_New"
                        Classes="chip">
                        <StackPanel Margin="11,0,0,0" Orientation="Horizontal" Spacing="{StaticResource NeapSpaceS}">
                            <PathIcon Width="{StaticResource NeapIconRow}" Height="{StaticResource NeapIconRow}" Data="{StaticResource IconAdd}" />
                            <TextBlock loc:Uid.Value="Equaliser_NewLabel" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="FreeSlots"
                        Margin="12,4,0,2"
                        Classes="caption secondary" />
                </StackPanel>
            </Border>

            <Border x:Name="EditorCard" Classes="card" Grid.Column="1">
                <StackPanel Spacing="{StaticResource NeapSpaceL}">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource NeapSpaceM}">
                        <!--
                            How the curve is shaped: band by band, or by
                            adjustments fitted to the bands. Only the game
                            bank has the second.
                        -->
                        <Border
                            x:Name="Mode"
                            loc:Uid.Value="Equaliser_Mode"
                            Classes="segmented"
                            IsVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    x:Name="ModeBands"
                                    loc:Uid.Value="Equaliser_ModeBands"
                                    GroupName="EqualiserMode"
                                    Theme="{StaticResource SegmentButton}" />
                                <RadioButton
                                    x:Name="ModeParametric"
                                    loc:Uid.Value="Equaliser_ModeParametric"
                                    GroupName="EqualiserMode"
                                    Theme="{StaticResource SegmentButton}">
                                    <!--
                                        Asked first, in place, when choosing Parametric would
                                        change what is heard, with the safe answer focused.
                                    -->
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout>
                                            <StackPanel MaxWidth="280" Spacing="{StaticResource NeapSpaceM}">
                                                <TextBlock x:Name="ParametricQuestion" />
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource NeapSpaceS}">
                                                    <Button x:Name="ParametricYes" loc:Uid.Value="Equaliser_ParametricYes" />
                                                    <Button x:Name="ParametricNo" loc:Uid.Value="Equaliser_ParametricNo" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!--
                            Save and Overwrite are always there, and disabled when
                            they cannot be used, so none moves under the pointer
                            when a band is first dragged. Discard, first, appears
                            to their left once there is an edit to discard, so
                            they stay put. Undo, Redo and Compare are quiet, in front
                            of them: they are for trying things, not for keeping them.
                            Overwrite's label names the preset and
                            changes width. It is left out for a factory preset, which can
                            never be overwritten. Saving a new preset is the
                            accent once there is an edit to keep, since it keeps
                            everything where overwriting loses the old curve;
                            before that it offers a duplicate, which is not the
                            thing to do next, and is plain. The row wraps under
                            the choice of mode when the card is too narrow.
                        -->
                        <WrapPanel
                            x:Name="Actions"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            ItemSpacing="{StaticResource NeapSpaceS}"
                            LineSpacing="{StaticResource NeapSpaceS}">
                            <Button
                                x:Name="UndoButton"
                                loc:Uid.Value="Equaliser_Undo"
                                Classes="quiet iconbutton"
                                IsEnabled="False">
                                <PathIcon
                                    Width="{StaticResource NeapIconRow}"
                                    Height="{StaticResource NeapIconRow}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="{StaticResource IconUndo}" />
                            </Button>
                            <Button
                                x:Name="RedoButton"
                                loc:Uid.Value="Equaliser_Redo"
                                Classes="quiet iconbutton"
                                IsEnabled="False">
                                <PathIcon
                                    Width="{StaticResource NeapIconRow}"
                                    Height="{StaticResource NeapIconRow}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="{StaticResource IconUndo}"
                                    RenderTransform="scale(-1, 1)" />
                            </Button>
                            <!-- Held, not clicked: see CompareHold. -->
                            <Button
                                x:Name="CompareButton"
                                loc:Uid.Value="Equaliser_Compare"
                                Classes="quiet"
                                HorizontalContentAlignment="Center" />
                            <Button
                                x:Name="DiscardButton"
                                loc:Uid.Value="Equaliser_DiscardButton"
                                HorizontalContentAlignment="Center"
                                IsVisible="False" />
                            <Button
                                x:Name="OverwriteButton"
                                HorizontalContentAlignment="Center"
                                IsEnabled="False">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel MaxWidth="280" Spacing="{StaticResource NeapSpaceM}">
                                            <TextBlock x:Name="OverwriteQuestion" />
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="{StaticResource NeapSpaceS}">
                                                <Button x:Name="OverwriteYes" loc:Uid.Value="Equaliser_OverwriteYes" />
                                                <Button x:Name="OverwriteNo" loc:Uid.Value="Equaliser_OverwriteNo" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                x:Name="SaveButton"
                                MinWidth="104"
                                HorizontalContentAlignment="Center"
                                IsEnabled="False" />
                        </WrapPanel>
                    </Grid>

                    <!-- Only when Compare could not change what is heard. -->
                    <TextBlock
                        x:Name="CompareTrouble"
                        Classes="secondary"
                        IsVisible="False" />

                    <!--
                        Parametric and the curve take the whole width of the
                        card, so they line up with the choice of mode above them.
                    -->
                    <c:ParametricPanel
                        x:Name="Parametric"
                        HorizontalAlignment="Stretch"
                        IsVisible="False" />

                    <!--
                        The curve and the readouts share one width and one set
                        of columns, so every point sits over its own number,
                        until the card is too narrow for ten readable values;
                        then they fold into two rows of five.
                    -->
                    <StackPanel x:Name="Curve" HorizontalAlignment="Stretch">
                        <Grid>
                            <c:EqualiserCurve x:Name="Response" Height="280" />
                            <Border
                                x:Name="FlatCaption"
                                Classes="comparecaption"
                                IsHitTestVisible="False"
                                IsVisible="False">
                                <TextBlock loc:Uid.Value="Equaliser_Flat" />
                            </Border>
                        </Grid>
                        <Grid x:Name="Bands" Margin="{StaticResource NeapSectionGap}" RowSpacing="{StaticResource NeapSpaceS}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!--
            Shown until the headset reports its bands, in place of the
            presets and the editor: a flat line would read as an equaliser
            set flat.
        -->
        <Border x:Name="Waiting" Classes="card">
            <StackPanel
                Margin="0,24"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource NeapSpaceM}">
                <ProgressBar
                    x:Name="WaitingRing"
                    Classes="busy"
                    VerticalAlignment="Center" />
                <TextBlock x:Name="WaitingText" Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
<UserControl
    x:Class="Neap.Desktop.Controls.MicTile"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <Grid>
    <ToggleButton x:Name="Face" Classes="tile" IsEnabled="False">
        <StackPanel Classes="tilebody">
            <Grid Classes="tilehead">
                <PathIcon
                    x:Name="Icon"
                    Classes="tileicon"
                    Data="{StaticResource IconMicrophone}" />
                <Border
                    x:Name="Glyph"
                    Classes="switchglyph"
                    AutomationProperties.AccessibilityView="Raw"
                    IsVisible="False">
                    <Ellipse />
                </Border>
            </Grid>
            <TextBlock
                loc:Uid.Value="Quick_Microphone"
                Classes="tiletitle" />
            <TextBlock x:Name="Word" Classes="tilestate" />
        </StackPanel>
    </ToggleButton>

    <c:SettingsCard x:Name="Row" Icon="{StaticResource IconMicrophone}" IsVisible="False" />
    </Grid>
</UserControl>

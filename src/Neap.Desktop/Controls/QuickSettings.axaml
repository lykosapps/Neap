<UserControl
    x:Class="Neap.Desktop.Controls.QuickSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <!--
        The settings reached for mid-game or mid-call, as cards on the page.
        Every card follows one pattern, so nothing has to be learned twice:
        its icon at the top left and its title, then its controls. There is
        no click target on the card itself.

        On or off is a switch at the top right of the head, and the card is
        tinted while it is on. A choice among a few is a segmented control
        under the title. A longer list is a drop-down. Where more settings
        live on another page, an accent link at the foot goes there. What
        cannot be used yet is faded and disabled, not hidden: the sound
        choice of Superhuman Hearing while it is off.

        Arrange sets them out on a grid six columns wide, three to a row when
        there is room and fewer as it narrows.
    -->
    <Grid
        x:Name="Tiles"
        ColumnDefinitions="*,*,*,*,*,*"
        ColumnSpacing="{StaticResource NeapSpaceS}"
        RowSpacing="{StaticResource NeapSpaceS}">

        <c:MicTile />

        <!--
            Noise cancellation is a choice of three, so the tile offers the
            three. Each is a radio button, so a screen reader says which of
            how many is chosen.
        -->
        <Border
            x:Name="NoiseTile"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconNoise}" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_NoiseControl"
                    Classes="tiletitle" />
                <Border
                    Margin="{StaticResource NeapSectionGap}"
                    Classes="segmented">
                    <c:NoiseModes
                        x:Name="NoiseModes"
                        loc:Uid.Value="Quick_NoiseTile"
                        AutomationProperties.AutomationId="home_noise_control" />
                </Border>
            </StackPanel>
        </Border>

        <!--
            The equaliser is not on or off, so its card is never tinted. It names
            the preset it is on and says when the equaliser is parametric,
            in a drop-down to pick one directly. Tuning is a
            sit-down job, so the way to the equaliser is a link under it.
        -->
        <Border
            x:Name="EqualiserTile"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconEqualiser}" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_Preset"
                    Classes="tiletitle" />
                <c:PresetChoice
                    x:Name="PresetPicker"
                    loc:Uid.Value="Quick_PresetPicker"
                    Margin="{StaticResource NeapSectionGap}"
                    HorizontalAlignment="Stretch" />
                <Button
                    x:Name="EqualiserLink"
                    loc:Uid.Value="Quick_EqualiserSettings"
                    Classes="link" />
            </StackPanel>
        </Border>

        <!--
            The one Audio setting made for the middle of a game: footsteps and
            quiet sounds. Its sound is chosen under the title while it is on,
            and shown faded while it is off. Its strength stays on Audio.
        -->
        <Border
            x:Name="ShhTile"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconHearing}" />
                    <ToggleSwitch
                        x:Name="ShhSwitch"
                        loc:Uid.Value="Quick_ShhTile"
                        Classes="tileswitch"
                        IsEnabled="False" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_Shh"
                    Classes="tiletitle" />
                <Border
                    x:Name="ShhSounds"
                    Margin="{StaticResource NeapSectionGap}"
                    Classes="segmented"
                    IsEnabled="False">
                    <StackPanel
                        x:Name="ShhModes"
                        loc:Uid.Value="Quick_ShhSounds"
                        AutomationProperties.AutomationId="home_shh_preset"
                        Orientation="Horizontal" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Spatial sound, on the systems that have it. -->
        <c:SpatialTile />
    </Grid>
</UserControl>

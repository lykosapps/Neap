<UserControl
    x:Class="Neap.Desktop.Controls.QuickSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:loc="using:Neap.Desktop.Localization">

    <!--
        The settings reached for mid-game or mid-call, as tiles straight on the
        page. Each shows how it works: a switch for the two that are on or off,
        the three modes for noise cancellation, the preset and the way to the
        equaliser for the equaliser, and a chevron for the one that opens a
        choice. Arrange sets them out on a grid six columns wide, three to a
        row when there is room and fewer as it narrows.
    -->
    <Grid
        x:Name="Tiles"
        ColumnDefinitions="*,*,*,*,*,*"
        ColumnSpacing="{StaticResource NeapSpaceS}"
        RowSpacing="{StaticResource NeapSpaceS}">

        <c:MicTile OnPage="True" />

        <!--
            Noise cancellation is a choice of three, so the tile offers the
            three. Each is a radio button, so a screen reader says which of
            how many is chosen.
        -->
        <Border
            x:Name="NoiseTile"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconNoise}" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_NoiseControl"
                    Classes="tiletitle" />
                <Border
                    Margin="{StaticResource NeapSectionGap}"
                    Classes="segmented">
                    <StackPanel
                        x:Name="NoiseModes"
                        loc:Uid.Value="Quick_NoiseTile"
                        AutomationProperties.AutomationId="home_noise_control"
                        IsEnabled="False"
                        Orientation="Horizontal">
                        <RadioButton x:Name="NoiseOff" GroupName="home_noise" Theme="{StaticResource SegmentButton}" />
                        <RadioButton x:Name="NoiseCancelling" GroupName="home_noise" Theme="{StaticResource SegmentButton}" />
                        <RadioButton x:Name="NoiseTransparent" GroupName="home_noise" Theme="{StaticResource SegmentButton}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--
            The equaliser is not on or off, so its tile never fills. It names
            the preset it is on, says when that preset comes from adjustments,
            and opens the presets to pick one directly. Tuning is a sit-down
            job, so the way to the equaliser is a link under it.
        -->
        <Border
            x:Name="EqualiserTile"
            MinHeight="{StaticResource NeapTileMinHeight}"
            Classes="card">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconEqualiser}" />
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_Preset"
                    Classes="tiletitle" />
                <Button
                    x:Name="PresetPicker"
                    loc:Uid.Value="Quick_PresetPicker"
                    Margin="{StaticResource NeapSectionGap}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="False">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ListBox
                                x:Name="PresetList"
                                MinWidth="260"
                                loc:Uid.Value="Quick_PresetList" />
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource NeapSpaceS}">
                        <TextBlock
                            x:Name="PresetName"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            x:Name="ParametricTag"
                            Grid.Column="1"
                            Classes="tag"
                            IsVisible="False">
                            <TextBlock x:Name="ParametricWord" />
                        </Border>
                        <PathIcon
                            Grid.Column="2"
                            Width="{StaticResource NeapIconRow}"
                            Height="{StaticResource NeapIconRow}"
                            AutomationProperties.AccessibilityView="Raw"
                            Data="{StaticResource IconChevronDown}" />
                    </Grid>
                </Button>
                <Button
                    x:Name="EqualiserLink"
                    loc:Uid.Value="Quick_EqualiserSettings"
                    Classes="link" />
            </StackPanel>
        </Border>

        <!--
            The one Audio setting made for the middle of a game: footsteps
            and quiet sounds. Its type and strength stay on Audio.
        -->
        <ToggleButton
            x:Name="ShhTile"
            loc:Uid.Value="Quick_ShhTile"
            Classes="tile home"
            IsEnabled="False">
            <StackPanel Classes="tilebody">
                <Grid Classes="tilehead">
                    <PathIcon
                        Classes="tileicon"
                        AutomationProperties.AccessibilityView="Raw"
                        Data="{StaticResource IconHearing}" />
                    <Border
                        Classes="switchglyph"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse />
                    </Border>
                </Grid>
                <TextBlock
                    loc:Uid.Value="Quick_Shh"
                    Classes="tiletitle" />
                <TextBlock x:Name="ShhWord" Classes="tilestate" />
            </StackPanel>
        </ToggleButton>

        <!-- Spatial sound, on the systems that have it. -->
        <c:SpatialTile />
    </Grid>
</UserControl>

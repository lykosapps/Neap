<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Neap's own look, the same on every system: a twilight ground and
        panels in place of the platform's grey, a violet-leaning dark in the
        dark theme and a pale lavender in the light one, so every page reads
        as the same product. The accent marks only what is on, in use or
        playing.

        Game and chat, from the half moon in the mark: game is the twilight
        wave, chat is the moon, silver on dark and ink on light, so the two
        sides differ in lightness as well as in hue and neither reads as a
        status colour. Fills are at least 3:1 against the window and text at
        least 4.5:1.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NeapGroundBrush" Color="#110E19" />
                    <RadialGradientBrush x:Key="NeapPanelBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="120%" RadiusY="90%">
                        <GradientStop Offset="0" Color="#2E2742" />
                        <GradientStop Offset="1" Color="#1E1929" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NeapPanelStrokeBrush" Color="#3B3351" />
                    <SolidColorBrush x:Key="NeapNoticeBrush" Color="#372B66" />
                    <SolidColorBrush x:Key="NeapRuleBrush" Color="#2B2440" />
                    <SolidColorBrush x:Key="NeapGameBrush" Color="#9D8CFF" />
                    <SolidColorBrush x:Key="NeapGameTextBrush" Color="#B2A5FF" />
                    <SolidColorBrush x:Key="NeapChatBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="NeapChatTextBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="NeapDialTrackBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NeapMeterUnlitBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="NeapTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NeapTextSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="NeapTextTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="NeapTextDisabledBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="NeapAccentTextBrush" Color="#C8BEFF" />
                    <SolidColorBrush x:Key="NeapToneGoodBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="NeapToneCautionBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="NeapToneNeutralBrush" Color="#8B8B8B" />
                    <SolidColorBrush x:Key="NeapToneCriticalBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="NeapQuietBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="NeapQuietHoverBrush" Color="#16FFFFFF" />

                    <!-- The page sits a step above the ground the rail is on, as in the Windows app. -->
                    <SolidColorBrush x:Key="NeapBodyBrush" Color="#171322" />
                    <SolidColorBrush x:Key="NeapNavSelectedBrush" Color="#25213B" />
                    <SolidColorBrush x:Key="NeapNavHoverBrush" Color="#1D192E" />

                    <!-- Buttons and the lists that open from them, in Neap's colours in place of the system's grey. -->
                    <SolidColorBrush x:Key="NeapButtonBrush" Color="#2A2340" />
                    <SolidColorBrush x:Key="NeapButtonHoverBrush" Color="#342C4D" />
                    <SolidColorBrush x:Key="NeapButtonPressedBrush" Color="#231D36" />
                    <SolidColorBrush x:Key="NeapButtonDisabledBrush" Color="#1F1A2B" />
                    <SolidColorBrush x:Key="NeapButtonStrokeBrush" Color="#37304D" />
                    <SolidColorBrush x:Key="NeapFlyoutBrush" Color="#231D36" />
                    <SolidColorBrush x:Key="NeapAccentFillBrush" Color="#C8BEFF" />
                    <SolidColorBrush x:Key="NeapAccentFillHoverBrush" Color="#BEB3FA" />
                    <SolidColorBrush x:Key="NeapAccentFillPressedBrush" Color="#B2A6EE" />
                    <SolidColorBrush x:Key="NeapOnAccentBrush" Color="#15112A" />
                    <StaticResource x:Key="ButtonBackground" ResourceKey="NeapButtonBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="NeapButtonBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <SolidColorBrush x:Key="NeapSelectedBrush" Color="#3B3263" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="NeapSelectedBrush" />
                    <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent" />
                    <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="SliderThumbBackground" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="NeapQuietBrush" />
                    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="NeapQuietHoverBrush" />
                    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                    <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <Color x:Key="SystemAccentColor">#9D8CFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#B2A5FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#C8BEFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#E1DBFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#6D5AD9</Color>
                    <Color x:Key="SystemAccentColorDark2">#5845BD</Color>
                    <Color x:Key="SystemAccentColorDark3">#40309A</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NeapGroundBrush" Color="#EFECF6" />
                    <RadialGradientBrush x:Key="NeapPanelBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="120%" RadiusY="90%">
                        <GradientStop Offset="0" Color="#FFFFFF" />
                        <GradientStop Offset="1" Color="#F0EDF7" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="NeapPanelStrokeBrush" Color="#DDD8E8" />
                    <SolidColorBrush x:Key="NeapNoticeBrush" Color="#E4DDF8" />
                    <SolidColorBrush x:Key="NeapRuleBrush" Color="#E2DEEC" />
                    <SolidColorBrush x:Key="NeapGameBrush" Color="#6D5AD9" />
                    <SolidColorBrush x:Key="NeapGameTextBrush" Color="#5845BD" />
                    <SolidColorBrush x:Key="NeapChatBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="NeapChatTextBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="NeapDialTrackBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="NeapMeterUnlitBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="NeapTextBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="NeapTextSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="NeapTextTertiaryBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="NeapTextDisabledBrush" Color="#5C000000" />
                    <SolidColorBrush x:Key="NeapAccentTextBrush" Color="#5845BD" />
                    <SolidColorBrush x:Key="NeapToneGoodBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="NeapToneCautionBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="NeapToneNeutralBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="NeapToneCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="NeapQuietBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="NeapQuietHoverBrush" Color="#FFFFFFFF" />

                    <SolidColorBrush x:Key="NeapBodyBrush" Color="#F7F5FB" />
                    <SolidColorBrush x:Key="NeapNavSelectedBrush" Color="#DBD6F1" />
                    <SolidColorBrush x:Key="NeapNavHoverBrush" Color="#E6E2F3" />

                    <SolidColorBrush x:Key="NeapButtonBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NeapButtonHoverBrush" Color="#F6F3FB" />
                    <SolidColorBrush x:Key="NeapButtonPressedBrush" Color="#ECE8F5" />
                    <SolidColorBrush x:Key="NeapButtonDisabledBrush" Color="#F3F0F8" />
                    <SolidColorBrush x:Key="NeapButtonStrokeBrush" Color="#E2DDEB" />
                    <SolidColorBrush x:Key="NeapFlyoutBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NeapAccentFillBrush" Color="#6D5AD9" />
                    <SolidColorBrush x:Key="NeapAccentFillHoverBrush" Color="#6350CF" />
                    <SolidColorBrush x:Key="NeapAccentFillPressedBrush" Color="#5845BD" />
                    <SolidColorBrush x:Key="NeapOnAccentBrush" Color="#FFFFFF" />
                    <StaticResource x:Key="ButtonBackground" ResourceKey="NeapButtonBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="NeapButtonBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="NeapButtonDisabledBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="NeapButtonStrokeBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <SolidColorBrush x:Key="NeapSelectedBrush" Color="#E3DDFA" />
                    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
                    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="NeapSelectedBrush" />
                    <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent" />
                    <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="NeapButtonHoverBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundPressed" ResourceKey="NeapButtonPressedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="NeapSelectedBrush" />
                    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="NeapFlyoutBrush" />
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="SliderThumbBackground" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="NeapAccentFillBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="NeapAccentFillHoverBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="NeapAccentFillPressedBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="NeapOnAccentBrush" />
                    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="NeapQuietBrush" />
                    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="NeapQuietHoverBrush" />
                    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                    <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="NeapPanelStrokeBrush" />
                    <Color x:Key="SystemAccentColor">#9D8CFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#B2A5FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#C8BEFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#E1DBFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#6D5AD9</Color>
                    <Color x:Key="SystemAccentColorDark2">#5845BD</Color>
                    <Color x:Key="SystemAccentColorDark3">#40309A</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- The type ramp. Sizes and weights match the Windows app's, so a page reads the same on either. -->
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.bodystrong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.bodylarge">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <!-- The name of a card that holds a choice or a device: a step above the rows inside it. -->
    <Style Selector="TextBlock.cardtitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A switch takes a click over the whole of its box, not only the part that is drawn. -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The page, a step above the rail it sits beside, edged on the side that meets the rail; the bar above has its own edge. -->
    <Style Selector="Border.pagebody">
        <Setter Property="Background" Value="{DynamicResource NeapBodyBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource NeapTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource NeapTextTertiaryBrush}" />
    </Style>

    <!-- A small label over what it names: a panel's title, a reading's name. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource NeapTextSecondaryBrush}" />
    </Style>

    <!-- A reading worth a glance, such as the battery or the mix levels: a big number. -->
    <Style Selector="TextBlock.reading">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <!-- The readings along the top of Home: worth a glance, but no larger than a card's title. -->
    <Style Selector="TextBlock.glance">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <!-- A panel on Home, lit from the top edge like a piece of gear on a desk. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource NeapPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- A list in a flyout, such as the profile bar's or spatial sound's, sits on the flyout's own colour like a drop-down's: nothing behind its items, and only the chosen one filled. -->
    <Style Selector="FlyoutPresenter ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="FlyoutPresenter ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="FlyoutPresenter ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource NeapSelectedBrush}" />
    </Style>

    <!-- A button that is only a picture: as high as every other button, and as wide. -->
    <Style Selector="Button.iconbutton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- A panel as quiet as a row of settings: the same corners and padding. -->
    <Style Selector="Border.card.compact">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- The toolkit draws a full-screen button beside the caption buttons; a Windows title bar has none, and it would sit over the status. -->
    <Style Selector="Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- A dialog on Neap's own ground, as the window is, in place of the system's grey. -->
    <Style Selector="Window.neapground">
        <Setter Property="Background" Value="{DynamicResource NeapGroundBrush}" />
    </Style>

    <!-- A mark in the accent, beside words it goes with. -->
    <Style Selector="PathIcon.accentmark">
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
    </Style>

    <!-- The update banner: a flat wash of the accent hue, with an accent edge down its left. -->
    <Style Selector="Border.update">
        <Setter Property="Background" Value="{DynamicResource NeapNoticeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.updateedge">
        <Setter Property="Background" Value="{DynamicResource NeapGameBrush}" />
    </Style>

    <!-- A rule under a group of controls, setting it apart from the list below. -->
    <Style Selector="Border.underlined">
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- What is in use, said in the accent. -->
    <Style Selector="TextBlock.inuse">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
    </Style>

    <!-- The dot beside the headset's state, one colour per tone. -->
    <Style Selector="Ellipse.good">
        <Setter Property="Fill" Value="{DynamicResource NeapToneGoodBrush}" />
    </Style>
    <Style Selector="Ellipse.caution">
        <Setter Property="Fill" Value="{DynamicResource NeapToneCautionBrush}" />
    </Style>
    <Style Selector="Ellipse.neutral">
        <Setter Property="Fill" Value="{DynamicResource NeapToneNeutralBrush}" />
    </Style>
    <Style Selector="Ellipse.critical">
        <Setter Property="Fill" Value="{DynamicResource NeapToneCriticalBrush}" />
    </Style>

    <!-- A notice: outlined in the tone it speaks in, with an icon that says the same. -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource NeapQuietBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource NeapToneCautionBrush}" />
    </Style>
    <Style Selector="Border.notice PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
    </Style>
    <Style Selector="Border.notice.warning PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource NeapToneCautionBrush}" />
    </Style>

    <!--
        A row of settings: icon, name, what it does, and its control on the
        right. The control keeps its own size and the name gives way to it.
    -->
    <Style Selector="c|SettingsCard">
        <Setter Property="Background" Value="{DynamicResource NeapQuietBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}">
                    <Grid x:Name="Layout" VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <PathIcon Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                  Data="{TemplateBinding Icon}" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                            <TextBlock Text="{TemplateBinding Header}" />
                            <TextBlock Text="{TemplateBinding Description}" Classes="caption secondary"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" x:Name="Control" Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The page's own name, at the top of every page. -->
    <Style Selector="TextBlock.pagetitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="1" />
    </Style>

    <!-- Groups the cards below it. Quiet: the cards are the content. -->
    <Style Selector="TextBlock.sectionheader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="2" />
    </Style>

    <!-- A line under a section's heading, saying what the section is. -->
    <Style Selector="TextBlock.sectionnote">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource NeapTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="MaxWidth" Value="620" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- The microphone meter's bars, lit in the accent like everything else that is live. -->
    <Style Selector="Rectangle.lit">
        <Setter Property="Fill" Value="{DynamicResource NeapGameBrush}" />
    </Style>
    <Style Selector="Rectangle.unlit">
        <Setter Property="Fill" Value="{DynamicResource NeapMeterUnlitBrush}" />
    </Style>

    <!-- Every page's column, held to a width that reads on a wide screen. -->
    <Style Selector="StackPanel.pagecolumn">
        <Setter Property="MaxWidth" Value="1040" />
    </Style>

    <!-- The icons: Material Design's, drawn from one path each and coloured by the text they sit beside. -->
    <!--
        An icon is a picture, not a thing to read: whatever carries it has the
        name, so a screen reader passes it by.
    -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>

    <!--
        The navigation rail: an icon and a name, the chosen place marked by a
        bar on its edge in the accent as well as by its fill, so it never
        rests on colour alone.
    -->
    <Style Selector="c|NavItem">
        <!-- Transparent, not nothing: a control with no fill takes a click only on its text and icon. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="False"
                                Background="{DynamicResource SystemAccentColorLight1}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,12,0" VerticalAlignment="Center">
                            <PathIcon Data="{TemplateBinding Icon}" Width="20" Height="20"
                                      Foreground="{DynamicResource NeapTextBrush}" />
                            <ContentPresenter x:Name="NavContent" Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center" TextElement.Foreground="{DynamicResource NeapTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="c|NavItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeapNavHoverBrush}" />
    </Style>
    <Style Selector="c|NavItem:selected">
        <Setter Property="Background" Value="{DynamicResource NeapNavSelectedBrush}" />
    </Style>
    <Style Selector="c|NavItem:selected /template/ Border#Marker">
        <Setter Property="IsVisible" Value="True" />
    </Style>
</Styles>

<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Buttons come in three weights. The primary one has Classes="accent":
        the accent fill with dark text. The plain Button is the secondary:
        a soft fill one step above its panel, with no outline. Classes="quiet" is
        text alone, with its fill only while pointed at or pressed.
        All are as high as a field and never smaller than a pointer target;
        the toolkit's focus mark is left as it is. Figtree's line sits its
        letters high in the box, so the padding is heavier above than below,
        which centres the letters rather than the line.
    -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{StaticResource NeapControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource NeapTargetMin}" />
        <Setter Property="Padding" Value="12,8,12,3" />
    </Style>

    <!--
        Sliders are the toolkit's own, in Neap's colours and sizes through the
        toolkit's names (FluentKeys and Tokens.axaml), so a click anywhere
        along the track, dragging and the keyboard all work as the toolkit
        makes them. A balance slider, such as the mini panel's game and chat
        mix, has no side that is more, so neither side of the thumb is filled.
    -->
    <Style Selector="Slider.balance /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource NeapDialTrackBrush}" />
    </Style>

    <!--
        A thin busy line: a short stretch of the accent on the slider's track.
        Motion.axaml sweeps it along while animation is on; with it off the
        line stands still, as everything else does. The toolkit's own
        indeterminate bar works out its sweep before it has a size, so it
        sweeps nowhere. The stretch is not the toolkit's PART_Indicator, which
        the bar sizes to its value, nothing, whenever it is not yet
        indeterminate; that part is kept, empty and hidden, as the bar
        requires one.
    -->
    <Style Selector="ProgressBar.busy">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource NeapDialTrackBrush}" CornerRadius="2" ClipToBounds="True">
                    <Panel>
                        <Border x:Name="PART_Indicator" IsVisible="False" />
                        <Border x:Name="Stretch"
                                Width="16"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource NeapAccentFillBrush}"
                                CornerRadius="2" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapButtonHoverBrush}" />
    </Style>
    <!-- A quiet button that cannot be used is dimmed, not boxed. -->
    <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapButtonPressedBrush}" />
    </Style>

    <Styles.Resources>
        <!--
            A segment of a segmented control: a radio button drawn as one part
            of a pill, filled in the accent when chosen. It stays a radio
            button, so a screen reader says which of how many is chosen and
            the arrow keys move the choice within its group.
        -->
        <ControlTheme x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NeapTextSecondaryBrush}" />
            <Setter Property="Padding" Value="{StaticResource NeapPaddingSegment}" />
            <Setter Property="MinWidth" Value="{StaticResource NeapTargetMin}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Segment"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource NeapRadiusSegment}"
                            Padding="{TemplateBinding Padding}">
                        <Panel>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="Ring" Margin="-3" IsVisible="False" IsHitTestVisible="False"
                                    BorderThickness="{StaticResource NeapFocusRingWidth}"
                                    BorderBrush="{DynamicResource NeapTextBrush}"
                                    CornerRadius="{StaticResource NeapRadiusSegment}" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#Segment">
                <Setter Property="Background" Value="{DynamicResource NeapTrackHoverBrush}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="{DynamicResource NeapOnAccentBrush}" />
                <Style Selector="^ /template/ Border#Segment">
                    <Setter Property="Background" Value="{DynamicResource NeapAccentFillBrush}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#Segment">
                    <Setter Property="Background" Value="{DynamicResource NeapAccentFillHoverBrush}" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource NeapTextDisabledBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#Ring">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>

        <!--
            One option of a list: a full-width inset row with the radio dot
            inside it. The chosen row is tinted with the selected fill and its
            text stays at full strength. The whole row is the target, and it
            stays a radio button, so a screen reader says which of how many is
            chosen.
        -->
        <ControlTheme x:Key="ChoiceRow" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeapCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
            <Setter Property="Padding" Value="{StaticResource NeapPaddingRow}" />
            <Setter Property="MinHeight" Value="{StaticResource NeapRowHeight}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Row"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource NeapRadiusInset}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <Panel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                <Panel Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="Outline" StrokeThickness="2"
                                             Stroke="{DynamicResource NeapTextSecondaryBrush}" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" IsVisible="False"
                                             Fill="{DynamicResource NeapAccentTextBrush}" />
                                </Panel>
                                <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="Ring" Margin="-3" IsVisible="False" IsHitTestVisible="False"
                                    BorderThickness="{StaticResource NeapFocusRingWidth}"
                                    BorderBrush="{DynamicResource NeapTextBrush}"
                                    CornerRadius="{StaticResource NeapRadiusInset}" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#Row">
                <Setter Property="Background" Value="{DynamicResource NeapQuietHoverBrush}" />
            </Style>
            <Style Selector="^:checked">
                <Style Selector="^ /template/ Border#Row">
                    <Setter Property="Background" Value="{DynamicResource NeapSelectedBrush}" />
                </Style>
                <Style Selector="^ /template/ Ellipse#Outline">
                    <Setter Property="Stroke" Value="{DynamicResource NeapAccentTextBrush}" />
                </Style>
                <Style Selector="^ /template/ Ellipse#Dot">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource NeapTextDisabledBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#Ring">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>

        <!--
            A switch: a pill track, the accent when on and a soft fill when off,
            with its On or Off word beside it.
        -->
        <ControlTheme x:Key="NeapSwitch" TargetType="ToggleSwitch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SwitchRoot" Background="{TemplateBinding Background}"
                            MinHeight="{StaticResource NeapTargetMin}">
                        <StackPanel x:Name="SwitchRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Panel VerticalAlignment="Center">
                                <Border x:Name="SwitchTrack"
                                        Width="{StaticResource NeapSwitchWidth}"
                                        Height="{StaticResource NeapSwitchHeight}"
                                        CornerRadius="{StaticResource NeapRadiusSegment}"
                                        BorderThickness="1"
                                        Background="{DynamicResource NeapTrackBrush}"
                                        BorderBrush="{DynamicResource NeapControlEdgeBrush}" />
                                <Border x:Name="Ring" Margin="-3" IsVisible="False" IsHitTestVisible="False"
                                        BorderThickness="{StaticResource NeapFocusRingWidth}"
                                        BorderBrush="{DynamicResource NeapTextBrush}"
                                        CornerRadius="{StaticResource NeapRadiusSegment}" />
                                <Grid x:Name="PART_SwitchKnob" IsHitTestVisible="False">
                                    <Grid x:Name="PART_MovingKnobs" HorizontalAlignment="Left" Margin="4,0">
                                        <Ellipse x:Name="SwitchKnobDot"
                                                 Width="{StaticResource NeapSwitchKnob}"
                                                 Height="{StaticResource NeapSwitchKnob}"
                                                 Fill="{DynamicResource NeapControlStrokeBrush}" />
                                    </Grid>
                                </Grid>
                            </Panel>
                            <ContentPresenter x:Name="PART_OffContentPresenter" Content="{TemplateBinding OffContent}"
                                              ContentTemplate="{TemplateBinding OffContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                            <ContentPresenter x:Name="PART_OnContentPresenter" Content="{TemplateBinding OnContent}"
                                              ContentTemplate="{TemplateBinding OnContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsVisible="False" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked">
                <Style Selector="^ /template/ Border#SwitchTrack">
                    <Setter Property="Background" Value="{DynamicResource NeapAccentFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource NeapAccentFillBrush}" />
                </Style>
                <Style Selector="^ /template/ Grid#PART_MovingKnobs">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
                <Style Selector="^ /template/ Ellipse#SwitchKnobDot">
                    <Setter Property="Fill" Value="{DynamicResource NeapOnAccentBrush}" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
            <Style Selector="^:pointerover:not(:checked) /template/ Border#SwitchTrack">
                <Setter Property="Background" Value="{DynamicResource NeapTrackHoverBrush}" />
            </Style>
            <Style Selector="^:pointerover:checked /template/ Border#SwitchTrack">
                <Setter Property="Background" Value="{DynamicResource NeapAccentFillHoverBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#Ring">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource NeapTextDisabledBrush}" />
                <Style Selector="^ /template/ Border#SwitchTrack">
                    <Setter Property="BorderBrush" Value="{DynamicResource NeapTextDisabledBrush}" />
                </Style>
                <Style Selector="^:checked /template/ Border#SwitchTrack">
                    <Setter Property="Background" Value="{DynamicResource NeapTextDisabledBrush}" />
                </Style>
                <Style Selector="^ /template/ Ellipse#SwitchKnobDot">
                    <Setter Property="Fill" Value="{DynamicResource NeapTextDisabledBrush}" />
                </Style>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- The pill a group of segments sits in: Theme="{StaticResource SegmentButton}" on each RadioButton inside it. -->
    <Style Selector="Border.segmented">
        <Setter Property="Height" Value="{StaticResource NeapSegmentHeight}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapControlEdgeBrush}" />
        <Setter Property="Background" Value="{DynamicResource NeapTrackBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusSegment}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- On a Steam Deck sized window (the touch class on the window) each grows to a 40px target. -->
    <Style Selector="Window.touch Border.segmented">
        <Setter Property="Height" Value="{StaticResource NeapTargetTouch}" />
    </Style>
    <Style Selector="Window.touch RadioButton /template/ Border#Row">
        <Setter Property="MinHeight" Value="{StaticResource NeapRowHeightTouch}" />
    </Style>
    <Style Selector="Window.touch Slider">
        <Setter Property="MinHeight" Value="{StaticResource NeapTargetTouch}" />
    </Style>
    <Style Selector="Window.touch ToggleSwitch /template/ Border#SwitchRoot">
        <Setter Property="MinHeight" Value="{StaticResource NeapTargetTouch}" />
    </Style>
    <Style Selector="Window.touch ToggleSwitch /template/ Border#SwitchTrack">
        <Setter Property="Width" Value="{StaticResource NeapSwitchTouchWidth}" />
        <Setter Property="Height" Value="{StaticResource NeapSwitchTouchHeight}" />
    </Style>
    <Style Selector="Window.touch ToggleSwitch /template/ Ellipse#SwitchKnobDot">
        <Setter Property="Width" Value="{StaticResource NeapSwitchTouchKnob}" />
        <Setter Property="Height" Value="{StaticResource NeapSwitchTouchKnob}" />
    </Style>
</Styles>

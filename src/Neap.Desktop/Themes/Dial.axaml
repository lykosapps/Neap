<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The dial's look: a flat knob with a quiet edge, inside a ring of
        segments that light in each side's colour. Every colour is a theme
        resource or a style class, so a change of theme while the page is open
        repaints it without code; the code only places the shapes. The sizes
        are tokens, and the code draws the ring and pointer to the same
        proportions.
    -->

    <!-- One segment of the ring, unlit and lit. -->
    <Style Selector="c|GameChatDial Path.segment">
        <Setter Property="Stroke" Value="{DynamicResource NeapDialTrackBrush}" />
        <Setter Property="StrokeThickness" Value="{StaticResource NeapDialSegmentWidth}" />
    </Style>
    <Style Selector="c|GameChatDial Path.segment.game">
        <Setter Property="Stroke" Value="{DynamicResource NeapGameBrush}" />
    </Style>
    <Style Selector="c|GameChatDial Path.segment.chat">
        <Setter Property="Stroke" Value="{DynamicResource NeapChatBrush}" />
    </Style>

    <!--
        The dial with no chat apps chosen: drawn, so the card shows what it is
        for, and faded well below its working contrast, so it plainly cannot
        be turned yet.
    -->
    <Style Selector="Viewbox.mixdial:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- The knob's pointer, in the colour of the side the mix leans to. -->
    <Style Selector="c|GameChatDial Path#Pointer">
        <Setter Property="Stroke" Value="{DynamicResource NeapGameTextBrush}" />
        <Setter Property="StrokeThickness" Value="{StaticResource NeapDialPointerWidth}" />
        <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="c|GameChatDial Path#Pointer.chat">
        <Setter Property="Stroke" Value="{DynamicResource NeapChatTextBrush}" />
    </Style>

    <Style Selector="c|GameChatDial">
        <Setter Property="Width" Value="{StaticResource NeapDialSize}" />
        <Setter Property="Height" Value="{StaticResource NeapDialSize}" />
        <!-- The ring below is the focus mark; the toolkit's square one drawn as well would box the dial in. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <!-- Where a keyboard user can see the keys are. -->
                    <Ellipse x:Name="FocusRing"
                             Width="{StaticResource NeapDialFocusSize}" Height="{StaticResource NeapDialFocusSize}"
                             IsVisible="False"
                             Stroke="{DynamicResource NeapAccentTextBrush}" StrokeThickness="2" />
                    <!-- The segments, placed by the code. -->
                    <Canvas x:Name="Ring" />
                    <Ellipse Width="{StaticResource NeapDialKnobSize}" Height="{StaticResource NeapDialKnobSize}"
                             Fill="{DynamicResource NeapKnobBrush}"
                             Stroke="{DynamicResource NeapKnobEdgeBrush}" StrokeThickness="1" />
                    <Path x:Name="Pointer" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|GameChatDial:focus-visible /template/ Ellipse#FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>
</Styles>

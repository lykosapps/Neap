<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The tiles on Home: flat buttons, one fill step above the page. A
        setting that is on fills its tile with the accent; the equaliser is
        not on or off, so its tile never fills and opens a list instead.
        Pressed, a tile dims a little, since it has no edge to drop onto.

        A tile that can not be changed, such as the microphone while the boom
        arm mutes it, is drawn in its own quieter colours rather than faded:
        its state still has to be read, so its text keeps 4.5:1.
    -->
    <Style Selector=":is(ToggleButton).tile, Button.tile">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource NeapPaddingCard}" />
        <Setter Property="MinHeight" Value="{StaticResource NeapTileMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusCard}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Face"
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource NeapTileBrush}"
                        BorderBrush="{DynamicResource NeapCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter x:Name="TileContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{DynamicResource NeapTileTextBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- A drawer is open under the tile: its bottom corners are squared to meet it. -->
        <Style Selector="^.open">
            <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusCardTop}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Face">
            <Setter Property="Background" Value="{DynamicResource NeapTileHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Face">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </Style>
    <!--
        A tile placed straight on the page, as on Home: the card's fill, not
        the inset one, since nothing sits behind it to set it against.
    -->
    <Style Selector=":is(ToggleButton).tile.home /template/ Border#Face, Button.tile.home /template/ Border#Face">
        <Setter Property="Background" Value="{DynamicResource NeapPanelBrush}" />
    </Style>
    <Style Selector=":is(ToggleButton).tile.home:pointerover /template/ Border#Face, Button.tile.home:pointerover /template/ Border#Face">
        <Setter Property="Background" Value="{DynamicResource NeapTileHoverBrush}" />
    </Style>

    <!--
        A switch drawn on a tile that is one: a picture of the setting's
        state, not a control, so the tile stays the one thing that can be
        pressed. On the accent fill it inverts, white with an accent knob.
    -->
    <Style Selector="Border.switchglyph">
        <Setter Property="Width" Value="{StaticResource NeapSwitchWidth}" />
        <Setter Property="Height" Value="{StaticResource NeapSwitchHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusSegment}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapControlStrokeBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.switchglyph > Ellipse">
        <Setter Property="Width" Value="{StaticResource NeapSwitchKnob}" />
        <Setter Property="Height" Value="{StaticResource NeapSwitchKnob}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource NeapControlStrokeBrush}" />
    </Style>
    <Style Selector=":is(ToggleButton).tile:checked Border.switchglyph">
        <Setter Property="Background" Value="{DynamicResource NeapTileOnTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapTileOnTextBrush}" />
    </Style>
    <Style Selector=":is(ToggleButton).tile:checked Border.switchglyph > Ellipse">
        <Setter Property="Fill" Value="{DynamicResource NeapTileOnBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--
        A link to another page: the accent, with an arrow after it. A button
        underneath, so the keyboard and screen readers reach it as one.
    -->
    <Style Selector="Button.link">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="LinkFace"
                        MinHeight="{StaticResource NeapTargetMin}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource NeapFocusRingWidth}"
                        CornerRadius="{StaticResource NeapRadiusTag}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceXS}" VerticalAlignment="Center">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                        <PathIcon Width="{StaticResource NeapIconRow}"
                                  Height="{StaticResource NeapIconRow}"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Data="{StaticResource IconArrowUp}"
                                  Foreground="{TemplateBinding Foreground}"
                                  RenderTransform="rotate(90deg)" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.link:focus-visible /template/ Border#LinkFace">
        <Setter Property="BorderBrush" Value="{DynamicResource NeapTextBrush}" />
    </Style>
    <Style Selector="Window.touch Button.link /template/ Border#LinkFace">
        <Setter Property="MinHeight" Value="{StaticResource NeapTargetTouch}" />
    </Style>

    <!--
        A row set into a card: a chooser or a field, one fill step above the
        card. The quiet fill is as white as the card in light, so it takes the
        navigation's selected fill, which is the inset's grey in both.
    -->
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource NeapNavSelectedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="Border.inset:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeapNavHoverBrush}" />
    </Style>

    <Style Selector=":is(ToggleButton).tile:checked">
        <Style Selector="^ /template/ Border#Face">
            <Setter Property="Background" Value="{DynamicResource NeapTileOnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeapTileOnStrokeBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Face">
            <Setter Property="Background" Value="{DynamicResource NeapTileOnHoverBrush}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#TileContent">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeapTileOnTextBrush}" />
        </Style>
    </Style>
    <Style Selector=":is(ToggleButton).tile:disabled">
        <Style Selector="^ /template/ Border#Face">
            <Setter Property="Background" Value="{DynamicResource NeapTileDisabledBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeapTileDisabledStrokeBrush}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#TileContent">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeapTileDisabledTextBrush}" />
        </Style>
    </Style>
    <Style Selector=":is(ToggleButton).tile:checked:disabled">
        <Style Selector="^ /template/ Border#Face">
            <Setter Property="Background" Value="{DynamicResource NeapTileOnDisabledBrush}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#TileContent">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeapTileOnDisabledTextBrush}" />
        </Style>
    </Style>
    <Style Selector="Button.tile:disabled /template/ Border#Face">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- A keyboard user can see which tile has the keys. -->
    <Style Selector=":is(ToggleButton).tile:focus-visible /template/ Border#Face, Button.tile:focus-visible /template/ Border#Face">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!--
        One anatomy for every tile on Home: a head row with the icon at the
        left and the tile's affordance at the right, then the title, then the
        state, then the tile's own control. The head row is one fixed height,
        so titles line up across a row of tiles.
    -->
    <Style Selector="StackPanel.tilebody">
        <Setter Property="Spacing" Value="{StaticResource NeapSpaceHairline}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.tilehead">
        <Setter Property="Height" Value="{StaticResource NeapTileHeadHeight}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="PathIcon.tileicon">
        <Setter Property="Width" Value="{StaticResource NeapIconTile}" />
        <Setter Property="Height" Value="{StaticResource NeapIconTile}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.tilechevron">
        <Setter Property="Width" Value="{StaticResource NeapIconRow}" />
        <Setter Property="Height" Value="{StaticResource NeapIconRow}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.tilehead > Border.switchglyph">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A tile's name and its state, under its icon. -->
    <Style Selector="TextBlock.tiletitle">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.tilestate">
        <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- The small curve beside a preset's name. -->
    <Style Selector="Path.minicurve">
        <Setter Property="Stroke" Value="{DynamicResource NeapGameTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!--
        A word beside a preset's name, such as "Parametric": outlined in the
        accent rather than filled, so it reads as a label and not a state.
    -->
    <Style Selector="Border.tag">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapAccentTextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
    </Style>

    <!--
        What a switch or a card reveals: the same width as what it hangs
        from and flush against its bottom, so the two read as one card split
        by a rule, not two stacked ones. A row inside it is the drawer's own,
        so it draws no card of its own.
    -->
    <Style Selector="Border.drawer">
        <Setter Property="Padding" Value="{StaticResource NeapPaddingCard}" />
        <Setter Property="Background" Value="{DynamicResource NeapPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusDrawer}" />
    </Style>
    <!-- Under a card or a tile rather than a row: the larger corners. -->
    <Style Selector="Border.drawer.large">
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusDrawerCard}" />
    </Style>
    <Style Selector="Border.drawer c|SettingsCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- A preset in Home's list: a flat row, the chosen one tinted and marked at its left edge. -->
    <Style Selector="ListBoxItem.preset">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="ListBoxItem.preset:pointerover /template/ ContentPresenter#TileContent">
        <Setter Property="Background" Value="{DynamicResource NeapPresetHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.preset:selected /template/ ContentPresenter#TileContent">
        <Setter Property="Background" Value="{DynamicResource NeapPresetSelectedBrush}" />
    </Style>
</Styles>

<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:c="using:Neap.Desktop.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The cards on Home. Each is a Border.card with one anatomy: a head row
        with the icon at the left and, where the card is on or off, its switch
        at the right, then the title, then the card's own control. A card
        that is on takes the soft tint and its text colour; the switch keeps
        its own look on it. Nothing on the card is a click target but its
        controls.
    -->
    <Style Selector="Border.card.on">
        <Setter Property="Background" Value="{DynamicResource NeapTileOnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapTileOnStrokeBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NeapTileOnTextBrush}" />
    </Style>

    <!--
        A quick tile in the mini panel: the inset's fill, taking the on tint
        while its setting is on, as Home's cards do. The icon at the top, the
        name and state at the foot, and the list's arrow in the top corner.
    -->
    <Style Selector="ToggleButton.quicktile">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapQuickStrokeBrush}" />
        <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.quicktile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapQuickStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.quicktile:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapQuickOnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapQuickStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapQuickOnTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.quicktile:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapQuickOnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapQuickStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapQuickOnTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.quicktile:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
    </Style>
    <!-- A row in the mini panel under its tiles, such as the equaliser's preset: as low as the tiles are plain. -->
    <Style Selector="Border.quickrow">
        <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapQuickStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="PathIcon.quickicon">
        <Setter Property="Width" Value="{StaticResource NeapIconRow}" />
        <Setter Property="Height" Value="{StaticResource NeapIconRow}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.quicktitle">
        <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A state such as "Muted by the boom arm" runs to a second line rather than being cut off; the tiles in a row grow together. -->
    <Style Selector="TextBlock.quickvalue">
        <Setter Property="FontSize" Value="{StaticResource NeapFontLabel}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.quickmore">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- The list's arrow sits on the tile, so it takes the tile's text colour while the tile is on. -->
    <Style Selector="c|QuickTile.on Button.quickmore">
        <Setter Property="Foreground" Value="{DynamicResource NeapQuickOnTextBrush}" />
    </Style>
    <Style Selector="Button.quickmore PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!--
        Something that cannot be used yet is shown faded, not hidden: a
        segmented control in a card, such as the sound of Superhuman Hearing
        while it is off.
    -->
    <Style Selector="Border.card Border.segmented:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!--
        The switch in a card's head, at its right and with no word beside it:
        the tint and the switch itself say the state, and the card's own
        line says anything more.
    -->
    <Style Selector="ToggleSwitch.tileswitch">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
    <Style Selector="ToggleSwitch.tileswitch /template/ StackPanel#SwitchRow">
        <Setter Property="Spacing" Value="0" />
    </Style>

    <!--
        A link to another page: the accent, with an arrow after it. A button
        underneath, so the keyboard and screen readers reach it as one.
        Pointed at, it takes the quiet button's fill and keeps its weight, so
        the text never changes size. The fill reaches past the text by its
        padding, and the margin takes that back, so the text lines up with
        what is around it.
    -->
    <Style Selector="Button.link">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="-8,0" />
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="LinkFace"
                        MinHeight="{StaticResource NeapTargetMin}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource NeapFocusRingWidth}"
                        CornerRadius="{StaticResource NeapRadiusTag}"
                        Padding="6,0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource NeapSpaceXS}" VerticalAlignment="Center">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                        <PathIcon Width="{StaticResource NeapIconRow}"
                                  Height="{StaticResource NeapIconRow}"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Data="{StaticResource IconArrowUp}"
                                  Foreground="{TemplateBinding Foreground}"
                                  RenderTransform="rotate(90deg)" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.link:pointerover /template/ Border#LinkFace">
        <Setter Property="Background" Value="{DynamicResource NeapButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ Border#LinkFace">
        <Setter Property="Background" Value="{DynamicResource NeapButtonPressedBrush}" />
    </Style>
    <Style Selector="Button.link:focus-visible /template/ Border#LinkFace">
        <Setter Property="BorderBrush" Value="{DynamicResource NeapTextBrush}" />
    </Style>
    <Style Selector="Window.touch Button.link /template/ Border#LinkFace">
        <Setter Property="MinHeight" Value="{StaticResource NeapTargetTouch}" />
    </Style>

    <!--
        A row set into a card: a chooser or a field, one fill step above the
        card. The quiet fill is as white as the card in light, so it takes the
        navigation's selected fill, which is the inset's grey in both.
    -->
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="Border.inset:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeapNavHoverBrush}" />
    </Style>

    <!--
        A field that opens a flyout: the multi-select counterpart to the setting
        rows' chooser. It reads as an inset, with the same quiet fill and hover,
        so a button that carries a list sits level with the fields beside it.
    -->
    <Style Selector="Button.chooser">
        <Setter Property="Background" Value="{DynamicResource NeapInsetBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
        <Setter Property="Padding" Value="{StaticResource NeapPaddingRow}" />
        <Setter Property="MinHeight" Value="{StaticResource NeapRowHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chooser:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapNavHoverBrush}" />
    </Style>
    <Style Selector="Button.chooser:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeapNavHoverBrush}" />
    </Style>

    <!--
        The anatomy of every card on Home: the head row is one fixed height,
        so titles line up across a row of cards.
    -->
    <Style Selector="StackPanel.tilebody">
        <Setter Property="Spacing" Value="{StaticResource NeapSpaceHairline}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.tilehead">
        <Setter Property="Height" Value="{StaticResource NeapTileHeadHeight}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="PathIcon.tileicon">
        <Setter Property="Width" Value="{StaticResource NeapIconTile}" />
        <Setter Property="Height" Value="{StaticResource NeapIconTile}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A card's name and its state, under its icon. -->
    <Style Selector="TextBlock.tiletitle">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.tilestate">
        <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- The small curve beside a preset's name. -->
    <Style Selector="Path.minicurve">
        <Setter Property="Stroke" Value="{DynamicResource NeapGameTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!--
        A word beside a preset's name, such as "Parametric": outlined in the
        accent rather than filled, so it reads as a label and not a state.
    -->
    <Style Selector="Border.tag">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapAccentTextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource NeapFontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource NeapAccentTextBrush}" />
    </Style>

    <!--
        What a switch or a card reveals: the same width as what it hangs
        from and flush against its bottom, so the two read as one card split
        by a rule, not two stacked ones. A row inside it is the drawer's own,
        so it draws no card of its own.
    -->
    <Style Selector="Border.drawer">
        <Setter Property="Padding" Value="{StaticResource NeapPaddingCard}" />
        <Setter Property="Background" Value="{DynamicResource NeapPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeapRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusDrawer}" />
    </Style>
    <!-- Under a card or a tile rather than a row: the larger corners. -->
    <Style Selector="Border.drawer.large">
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusDrawerCard}" />
    </Style>
    <Style Selector="Border.drawer c|SettingsCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- A preset in Home's list: a flat row, the chosen one tinted and marked at its left edge. -->
    <Style Selector="ListBoxItem.preset">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource NeapRadiusInset}" />
    </Style>
    <Style Selector="ListBoxItem.preset:pointerover /template/ ContentPresenter#TileContent">
        <Setter Property="Background" Value="{DynamicResource NeapPresetHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.preset:selected /template/ ContentPresenter#TileContent">
        <Setter Property="Background" Value="{DynamicResource NeapPresetSelectedBrush}" />
    </Style>
</Styles>
